@using TEXCEL_ERP.Helpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - TEXCEL ERP™</title>

    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <style>
        /* ============================================= */
        /* ROOT VARIABLES                                */
        /* ============================================= */
        :root {
            --primary: #6c3cb0;
            --primary-light: #8b5cf6;
            --primary-dark: #4c1d95;
            --primary-gradient: linear-gradient(135deg, #6c3cb0 0%, #8b5cf6 50%, #a78bfa 100%);
            --gold: #fbbf24;
            --gold-gradient: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
            --bg-body: #f0f2f5;
            --bg-card: rgba(255, 255, 255, 0.75);
            --bg-navbar: rgba(255, 255, 255, 0.85);
            --bg-glass: rgba(255, 255, 255, 0.35);
            --text-primary: #1a1a2e;
            --text-secondary: #6b7280;
            --text-muted: #9ca3af;
            --border-color: rgba(229, 231, 235, 0.5);
            --shadow: 0 8px 32px rgba(108, 60, 176, 0.10);
            --shadow-hover: 0 16px 48px rgba(108, 60, 176, 0.20);
            --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.08);
            --radius: 20px;
            --radius-lg: 28px;
            --radius-sm: 12px;
            --nav-height: 76px;
            --transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            --danger: #ef4444;
        }

        [data-theme="dark"] {
            --bg-body: #0a0a14;
            --bg-card: rgba(26, 26, 46, 0.85);
            --bg-navbar: rgba(26, 26, 46, 0.90);
            --bg-glass: rgba(26, 26, 46, 0.40);
            --text-primary: #f1f5f9;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --border-color: rgba(45, 45, 68, 0.6);
            --shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
            --shadow-hover: 0 16px 48px rgba(108, 60, 176, 0.25);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-body);
            color: var(--text-primary);
            min-height: 100vh;
            transition: var(--transition);
            position: relative;
        }

            body::before {
                content: '';
                position: fixed;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(ellipse at 20% 50%, rgba(108, 60, 176, 0.03) 0%, transparent 50%), radial-gradient(ellipse at 80% 20%, rgba(139, 92, 246, 0.03) 0%, transparent 50%), radial-gradient(ellipse at 50% 80%, rgba(251, 191, 36, 0.02) 0%, transparent 50%);
                z-index: 0;
                animation: bgFloat 20s ease-in-out infinite alternate;
                pointer-events: none;
            }

        @@keyframes bgFloat {
            0% {
                transform: translate(0, 0) rotate(0deg);
            }

            100% {
                transform: translate(-5%, -5%) rotate(5deg);
            }
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg-body);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--primary-gradient);
            border-radius: 10px;
        }

        /* ============================================= */
        /* TOP NAVBAR                                    */
        /* ============================================= */
        .top-navbar {
            background: var(--bg-navbar);
            padding: 0 36px;
            height: var(--nav-height);
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border-color);
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 1050;
            transition: var(--transition);
        }

            .top-navbar .brand {
                display: flex;
                align-items: center;
                gap: 14px;
                text-decoration: none;
                flex-shrink: 0;
            }

                .top-navbar .brand .logo-wrapper {
                    position: relative;
                    width: 52px;
                    height: 52px;
                    flex-shrink: 0;
                }

                    .top-navbar .brand .logo-wrapper::before {
                        content: '';
                        position: absolute;
                        inset: -4px;
                        border-radius: 16px;
                        background: var(--gold-gradient);
                        opacity: 0.4;
                        filter: blur(12px);
                        animation: logoGlow 3s ease-in-out infinite alternate;
                    }

        @@keyframes logoGlow {
            0% {
                opacity: 0.3;
                transform: scale(1);
            }

            100% {
                opacity: 0.7;
                transform: scale(1.05);
            }
        }

        .top-navbar .brand .logo-icon {
            position: relative;
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: var(--primary-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 24px rgba(108, 60, 176, 0.35);
            overflow: hidden;
        }

            .top-navbar .brand .logo-icon::after {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.2) 50%, transparent 60%);
                animation: shimmerLogo 4s ease-in-out infinite;
            }

        @@keyframes shimmerLogo {
            0% {
                transform: translateX(-100%) rotate(25deg);
            }

            100% {
                transform: translateX(100%) rotate(25deg);
            }
        }

        .top-navbar .brand .logo-icon i {
            color: white;
            font-size: 24px;
            position: relative;
            z-index: 1;
        }

        .top-navbar .brand .brand-text h2 {
            font-size: 24px;
            font-weight: 800;
            color: var(--text-primary);
            font-family: 'Space Grotesk', sans-serif;
            letter-spacing: -0.5px;
        }

            .top-navbar .brand .brand-text h2 .highlight {
                background: var(--primary-gradient);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

        .top-navbar .brand .brand-tagline {
            font-size: 9px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 2.5px;
            font-weight: 500;
            display: block;
            margin-top: -1px;
            opacity: 0.7;
        }

            .top-navbar .brand .brand-tagline .gold-dot {
                color: var(--gold);
                font-size: 10px;
            }

        /* ============================================= */
        /* NAV LINKS + DROPDOWN                          */
        /* ============================================= */
        .nav-links {
            display: flex;
            align-items: center;
            gap: 2px;
            list-style: none;
            flex: 1;
            justify-content: center;
        }

            .nav-links .nav-item {
                position: relative;
            }

            .nav-links .nav-link {
                padding: 8px 16px;
                border-radius: var(--radius-sm);
                color: var(--text-secondary);
                text-decoration: none;
                font-size: 13px;
                font-weight: 500;
                transition: var(--transition);
                display: flex;
                align-items: center;
                gap: 8px;
                position: relative;
                white-space: nowrap;
                cursor: pointer;
            }

                .nav-links .nav-link:hover {
                    background: rgba(108, 60, 176, 0.08);
                    color: var(--primary-light);
                }

                .nav-links .nav-link.active {
                    background: rgba(108, 60, 176, 0.12);
                    color: var(--primary-light);
                    font-weight: 600;
                }

                    .nav-links .nav-link.active::before {
                        content: '';
                        position: absolute;
                        bottom: 2px;
                        left: 50%;
                        transform: translateX(-50%);
                        width: 20px;
                        height: 3px;
                        background: var(--gold-gradient);
                        border-radius: 3px;
                    }

                .nav-links .nav-link i {
                    font-size: 14px;
                }

            .nav-links .has-dropdown > .nav-link::after {
                content: '\f107';
                font-family: 'Font Awesome 6 Free';
                font-weight: 900;
                font-size: 10px;
                margin-left: 4px;
                transition: transform 0.3s;
            }

            .nav-links .has-dropdown:hover > .nav-link::after,
            .nav-links .has-dropdown.open > .nav-link::after {
                transform: rotate(180deg);
            }

            .nav-links .dropdown-menu {
                position: absolute;
                top: 100%;
                left: 0;
                min-width: 230px;
                background: var(--bg-card);
                backdrop-filter: blur(24px);
                border: 1px solid var(--border-color);
                border-radius: 14px;
                box-shadow: 0 12px 40px rgba(108, 60, 176, 0.20);
                padding: 8px;
                list-style: none;
                opacity: 0;
                visibility: hidden;
                transform: translateY(-10px);
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                z-index: 100;
                margin-top: 8px;
            }

            .nav-links .has-dropdown:hover .dropdown-menu,
            .nav-links .has-dropdown.open .dropdown-menu {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

            .nav-links .dropdown-menu li {
                margin: 0;
            }

            .nav-links .dropdown-menu a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 14px;
                border-radius: 10px;
                font-size: 13px;
                font-weight: 500;
                color: var(--text-secondary);
                text-decoration: none;
                transition: all 0.3s;
                white-space: nowrap;
            }

                .nav-links .dropdown-menu a:hover {
                    background: rgba(108, 60, 176, 0.08);
                    color: var(--primary-light);
                    padding-left: 18px;
                }

                .nav-links .dropdown-menu a i {
                    font-size: 14px;
                    width: 18px;
                    text-align: center;
                    color: var(--primary-light);
                }

            .nav-links .dropdown-menu .dropdown-divider {
                height: 1px;
                background: var(--border-color);
                margin: 6px 8px;
                border: none;
            }

        /* ============================================= */
        /* NAVBAR RIGHT                                  */
        /* ============================================= */
        .navbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

            .navbar-right .btn-icon {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                border: none;
                background: var(--bg-body);
                color: var(--text-secondary);
                font-size: 17px;
                cursor: pointer;
                transition: var(--transition);
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
            }

                .navbar-right .btn-icon:hover {
                    background: rgba(108, 60, 176, 0.10);
                    color: var(--primary-light);
                    transform: scale(1.05);
                }

                .navbar-right .btn-icon .dot {
                    position: absolute;
                    top: 6px;
                    right: 6px;
                    width: 9px;
                    height: 9px;
                    background: var(--danger);
                    border-radius: 50%;
                    border: 2px solid var(--bg-navbar);
                    animation: pulse-dot 2s infinite;
                }

        @@keyframes pulse-dot {
            0%, 100% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.4);
                opacity: 0.7;
            }
        }

        /* ===== USER PROFILE WRAPPER ===== */
        .user-profile-wrapper {
            position: relative;
        }

            .user-profile-wrapper .user-avatar-btn {
                cursor: pointer;
            }

        .navbar-right .user-avatar-btn {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: var(--primary-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 14px;
            text-decoration: none;
            position: relative;
            border: 2px solid var(--gold);
            box-shadow: 0 4px 16px rgba(108, 60, 176, 0.30);
            transition: var(--transition);
        }

            .navbar-right .user-avatar-btn:hover {
                transform: scale(1.06);
                box-shadow: 0 6px 24px rgba(108, 60, 176, 0.45);
            }

        /* ===== USER DROPDOWN ===== */
        .user-dropdown {
            position: absolute;
            top: calc(100% + 12px);
            right: 0;
            min-width: 260px;
            background: var(--bg-card);
            backdrop-filter: blur(24px);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: 0 16px 48px rgba(108, 60, 176, 0.20);
            padding: 8px;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 100;
        }

            .user-dropdown.open {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

        .user-dropdown-header {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
        }

        .user-avatar-lg {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--primary-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 18px;
            border: 2px solid var(--gold);
            flex-shrink: 0;
        }

        .user-dropdown-info h4 {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 2px 0;
            font-family: 'Space Grotesk', sans-serif;
        }

        .user-dropdown-info p {
            font-size: 11px;
            color: var(--text-muted);
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .user-dropdown-divider {
            height: 1px;
            background: var(--border-color);
            margin: 6px 8px;
        }

        .user-dropdown-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-secondary);
            text-decoration: none;
            transition: all 0.3s;
            background: none;
            border: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
        }

            .user-dropdown-item:hover {
                background: rgba(108, 60, 176, 0.08);
                color: var(--primary-light);
                padding-left: 18px;
            }

            .user-dropdown-item i {
                font-size: 14px;
                width: 18px;
                text-align: center;
                color: var(--primary-light);
            }

            .user-dropdown-item.logout-btn {
                color: #ef4444;
            }

                .user-dropdown-item.logout-btn i {
                    color: #ef4444;
                }

                .user-dropdown-item.logout-btn:hover {
                    background: rgba(239, 68, 68, 0.08);
                    color: #ef4444;
                }

        /* ============================================= */
        /* MOBILE TOGGLE                                 */
        /* ============================================= */
        .navbar-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 22px;
            color: var(--text-primary);
            cursor: pointer;
            padding: 4px;
        }

        /* ============================================= */
        /* PAGE CONTENT                                  */
        /* ============================================= */
        .page-content {
            padding: 28px 36px 40px 36px;
            max-width: 1440px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }

        /* ============================================= */
        /* FOOTER                                        */
        /* ============================================= */
        .footer {
            background: var(--bg-card);
            backdrop-filter: blur(16px);
            border-top: 1px solid var(--border-color);
            padding: 22px 36px;
            text-align: center;
            font-size: 13px;
            color: var(--text-muted);
            position: relative;
            z-index: 1;
        }

            .footer strong {
                color: var(--primary-light);
            }

            .footer .version-badge {
                font-size: 10px;
                padding: 2px 12px;
                border-radius: 20px;
                background: rgba(108, 60, 176, 0.10);
                color: var(--primary-light);
                font-weight: 600;
            }

        /* ============================================= */
        /* MODAL OPEN STATE — Navbar/Footer Blur          */
        /* ============================================= */
      
        /* ============================================= */
        /* RESPONSIVE                                    */
        /* ============================================= */
        @@media (max-width: 1200px) {
            .nav-links .nav-link {
                padding: 8px 12px;
                font-size: 12px;
            }

                .nav-links .nav-link i {
                    font-size: 13px;
                }
        }

        @@media (max-width: 992px) {
            .navbar-toggle {
                display: block;
            }

            .nav-links {
                display: none;
                position: absolute;
                top: var(--nav-height);
                left: 0;
                right: 0;
                background: var(--bg-navbar);
                backdrop-filter: blur(24px);
                flex-direction: column;
                padding: 16px 24px;
                border-bottom: 1px solid var(--border-color);
                box-shadow: var(--shadow-lg);
                gap: 4px;
                max-height: calc(100vh - var(--nav-height));
                overflow-y: auto;
            }

                .nav-links.open {
                    display: flex;
                }

                .nav-links .nav-link {
                    width: 100%;
                    padding: 12px 16px;
                    font-size: 14px;
                    justify-content: space-between;
                }

                .nav-links .dropdown-menu {
                    position: static;
                    opacity: 1;
                    visibility: visible;
                    transform: none;
                    box-shadow: none;
                    border: none;
                    background: transparent;
                    padding: 0 0 0 20px;
                    margin-top: 0;
                    max-height: 0;
                    overflow: hidden;
                    transition: max-height 0.3s ease;
                }

                .nav-links .has-dropdown.open .dropdown-menu {
                    max-height: 500px;
                    padding: 4px 0 8px 20px;
                }

                .nav-links .dropdown-menu a {
                    padding: 8px 12px;
                    font-size: 13px;
                }

            .top-navbar {
                padding: 0 16px;
            }

            .page-content {
                padding: 16px;
            }
        }

        @@media (max-width: 768px) {
            .top-navbar .brand .brand-tagline {
                display: none;
            }

            .top-navbar .brand .brand-text h2 {
                font-size: 18px;
            }

            .top-navbar .brand .logo-wrapper {
                width: 44px;
                height: 44px;
            }

            .top-navbar .brand .logo-icon {
                width: 44px;
                height: 44px;
            }

                .top-navbar .brand .logo-icon i {
                    font-size: 20px;
                }
        }

        /* ============================================= */
        /* MODAL OPEN STATE — Footer/Content Blur        */
        /* ============================================= */
        /* ✅ Footer — modal ke waqt hide */
        body.modal-open .footer {
            visibility: hidden;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease, visibility 0.3s ease;
            z-index: -1 !important;
        }

        /* ✅ Navbar — z-index neeche */
        body.modal-open .top-navbar {
            z-index: 1 !important;
        }

        /* ✅ Modal — hamesha upar */
        body.modal-open .modal-bg,
        body.modal-open .modal-box {
            filter: none !important;
            pointer-events: auto !important;
            z-index: 2147483647 !important;
        }

        /* ============================================= */
        /* TOAST NOTIFICATIONS — GLOBAL                   */
        /* ============================================= */
        #toastContainer {
            position: fixed;
            top: 90px;
            right: 20px;
            z-index: 999999;
            display: flex;
            flex-direction: column;
            gap: 10px;
            pointer-events: none;
        }

        .toast {
            padding: 14px 20px;
            border-radius: 10px;
            background: #ffffff;
            color: #333;
            font-size: 14px;
            font-weight: 600;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.20);
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 260px;
            max-width: 400px;
            pointer-events: auto;
            border-left: 4px solid #8b5cf6;
            animation: toastIn 0.3s ease;
        }

        [data-theme="dark"] .toast {
            background: #1a1a2e;
            color: #fff;
        }

        .toast-success {
            border-left-color: #10b981;
        }

            .toast-success i {
                color: #10b981;
            }

        .toast-error {
            border-left-color: #ef4444;
        }

            .toast-error i {
                color: #ef4444;
            }

        .toast-info {
            border-left-color: #8b5cf6;
        }

            .toast-info i {
                color: #8b5cf6;
            }

        @@keyframes toastIn {
            from {
                opacity: 0;
                transform: translateX(40px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }


        /* ============================================= */
        /* REPORT SUB-NAVIGATION — Multi-Color Outline   */
        /* ============================================= */
        .report-subnav {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 20px;
            padding: 0;
            background: transparent;
            border: none;
            flex-wrap: wrap;
        }

            .report-subnav .report-nav-item {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 7px 14px;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 700;
                text-decoration: none;
                transition: all 0.25s ease;
                font-family: 'Inter', sans-serif;
                white-space: nowrap;
                background: transparent;
                border: 1.5px solid;
            }

                .report-subnav .report-nav-item i {
                    font-size: 12px;
                    transition: transform 0.25s;
                }

                .report-subnav .report-nav-item:hover {
                    text-decoration: none;
                    transform: translateY(-1px);
                }

                    .report-subnav .report-nav-item:hover i {
                        transform: scale(1.15);
                    }

                /* Active state — filled with color */
                .report-subnav .report-nav-item.active {
                    color: white !important;
                }

            /* ============================================= */
            /* 1. HUB — Slate Blue                           */
            /* ============================================= */
            .report-subnav .nav-hub {
                border-color: #475569;
                color: #475569;
            }

                .report-subnav .nav-hub:hover {
                    background: rgba(71, 85, 105, 0.10);
                }

                .report-subnav .nav-hub.active {
                    background: #475569;
                    border-color: #475569;
                    box-shadow: 0 4px 12px rgba(71, 85, 105, 0.30);
                }

            /* ============================================= */
            /* 2. DAILY — Coral                              */
            /* ============================================= */
            .report-subnav .nav-daily {
                border-color: #ff6b6b;
                color: #ff6b6b;
            }

                .report-subnav .nav-daily:hover {
                    background: rgba(255, 107, 107, 0.10);
                }

                .report-subnav .nav-daily.active {
                    background: #ff6b6b;
                    border-color: #ff6b6b;
                    box-shadow: 0 4px 12px rgba(255, 107, 107, 0.35);
                }

            /* ============================================= */
            /* 3. MONTHLY — Light Burgundy                   */
            /* ============================================= */
            .report-subnav .nav-monthly {
                border-color: #a1556d;
                color: #a1556d;
            }

                .report-subnav .nav-monthly:hover {
                    background: rgba(161, 85, 109, 0.10);
                }

                .report-subnav .nav-monthly.active {
                    background: #a1556d;
                    border-color: #a1556d;
                    box-shadow: 0 4px 12px rgba(161, 85, 109, 0.35);
                }

            /* ============================================= */
            /* 4. LATE & OT — Amber/Brown                    */
            /* ============================================= */
            .report-subnav .nav-lateot {
                border-color: #b45309;
                color: #b45309;
            }

                .report-subnav .nav-lateot:hover {
                    background: rgba(180, 83, 9, 0.10);
                }

                .report-subnav .nav-lateot.active {
                    background: #b45309;
                    border-color: #b45309;
                    box-shadow: 0 4px 12px rgba(180, 83, 9, 0.35);
                }

            /* ============================================= */
            /* 5. DEPARTMENT — Forest Green                  */
            /* ============================================= */
            .report-subnav .nav-dept {
                border-color: #059669;
                color: #059669;
            }

                .report-subnav .nav-dept:hover {
                    background: rgba(5, 150, 105, 0.10);
                }

                .report-subnav .nav-dept.active {
                    background: #059669;
                    border-color: #059669;
                    box-shadow: 0 4px 12px rgba(5, 150, 105, 0.35);
                }

            /* ============================================= */
            /* 6. GRAPHS — Plum/Purple                       */
            /* ============================================= */
            .report-subnav .nav-graph {
                border-color: #7c3aed;
                color: #7c3aed;
            }

                .report-subnav .nav-graph:hover {
                    background: rgba(124, 58, 237, 0.10);
                }

                .report-subnav .nav-graph.active {
                    background: #7c3aed;
                    border-color: #7c3aed;
                    box-shadow: 0 4px 12px rgba(124, 58, 237, 0.35);
                }

            /* ============================================= */
            /* 7. FULL — Teal                                */
            /* ============================================= */
            .report-subnav .nav-full {
                border-color: #0d9488;
                color: #0d9488;
            }

                .report-subnav .nav-full:hover {
                    background: rgba(13, 148, 136, 0.10);
                }

                .report-subnav .nav-full.active {
                    background: #0d9488;
                    border-color: #0d9488;
                    box-shadow: 0 4px 12px rgba(13, 148, 136, 0.35);
                }

        /* Mobile */
        @@media (max-width: 700px) {
            .report-subnav {
                overflow-x: auto;
                flex-wrap: nowrap;
                -webkit-overflow-scrolling: touch;
                padding-bottom: 4px;
            }

                .report-subnav .report-nav-item span {
                    display: none;
                }

                .report-subnav .report-nav-item {
                    padding: 7px 12px;
                }
        }




    </style>
    @RenderSection("styles", required: false)
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>
<body>

    <!-- ============================================= -->
    <!-- TOP NAVBAR                                    -->
    <!-- ============================================= -->
    <nav class="top-navbar" id="mainNavbar">
        <a href="@Url.Action("Index", "Dashboard")" class="brand">
            <div class="logo-wrapper">
                <div class="logo-icon">
                    <i class="fas fa-tshirt"></i>
                </div>
            </div>
            <div class="brand-text">
                <h2>TEXCEL <span class="highlight">ERP</span></h2>
                <span class="brand-tagline"><span class="gold-dot">◆</span> Textile &amp; Garment <span class="gold-dot">◆</span></span>
            </div>
        </a>

        <button class="navbar-toggle" id="navToggle" aria-label="Toggle navigation">
            <i class="fas fa-bars"></i>
        </button>

        <!-- NAV LINKS — Role-Based Menu -->
        <ul class="nav-links" id="navLinks">

            <!-- Dashboard (Always Visible) -->
            <li class="nav-item">
                <a href="@Url.Action("Index", "Dashboard")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Dashboard" ? "active" : "")">
                    <i class="fas fa-th-large"></i> Dashboard
                </a>
            </li>

            <!-- HR MODULE (SuperAdmin, BranchAdmin, Manager) -->
            @if (TEXCEL_ERP.Helpers.SessionHelper.IsSuperAdmin
              || TEXCEL_ERP.Helpers.SessionHelper.IsBranchAdmin
              || TEXCEL_ERP.Helpers.SessionHelper.IsManager)
            {
                <li class="nav-item has-dropdown">
                    <a href="javascript:void(0);" class="nav-link">
                        <i class="fas fa-users"></i> HR
                    </a>
                    <ul class="dropdown-menu">
                        <li><a href="@Url.Action("Index", "Employee")"><i class="fas fa-user-tie"></i> Employees</a></li>
                        <li><a href="@Url.Action("Index", "Department")"><i class="fas fa-sitemap"></i> Departments</a></li>
                        <li><a href="@Url.Action("Index", "Designation")"><i class="fas fa-id-badge"></i> Designations</a></li>
                        <li><a href="@Url.Action("Index", "Shift")"><i class="fas fa-clock"></i> Shifts</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a href="@Url.Action("Index", "Attendance")"><i class="fas fa-calendar-check"></i> Attendance</a></li>
                        <li><a href="@Url.Action("Index", "Leave")"><i class="fas fa-plane-departure"></i> Leaves</a></li>
                        <li><a href="@Url.Action("Index", "Payroll")"><i class="fas fa-wallet"></i> Payroll</a></li>
                    </ul>
                </li>
            }

            <!-- My Profile (Employee Only) -->
            @if (TEXCEL_ERP.Helpers.SessionHelper.IsEmployee && TEXCEL_ERP.Helpers.SessionHelper.EmployeeId.HasValue)
            {
                <li class="nav-item">
                    <a href="@Url.Action("Details", "Employee", new { id = TEXCEL_ERP.Helpers.SessionHelper.EmployeeId })" class="nav-link">
                        <i class="fas fa-user"></i> My Profile
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("MyAttendance", "Attendance")" class="nav-link">
                        <i class="fas fa-calendar-check"></i> My Attendance
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("MyPayslip", "Payroll")" class="nav-link">
                        <i class="fas fa-wallet"></i> My Salary
                    </a>
                </li>
            }

            <!-- INVENTORY MODULE (Admin, Manager) -->
            @if (TEXCEL_ERP.Helpers.SessionHelper.CanEdit)
            {
                <li class="nav-item has-dropdown">
                    <a href="javascript:void(0);" class="nav-link">
                        <i class="fas fa-boxes"></i> Inventory
                    </a>
                    <ul class="dropdown-menu">
                        <li><a href="@Url.Action("Index", "Fabric")"><i class="fas fa-layer-group"></i> Fabrics</a></li>
                        <li><a href="@Url.Action("Index", "Supplier")"><i class="fas fa-truck"></i> Suppliers</a></li>
                        <li><a href="@Url.Action("Index", "Purchase")"><i class="fas fa-shopping-cart"></i> Purchase Orders</a></li>
                        <li><a href="@Url.Action("GRN", "Fabric")"><i class="fas fa-dolly"></i> GRN</a></li>
                        <li><a href="@Url.Action("Stock", "Fabric")"><i class="fas fa-warehouse"></i> Stock Status</a></li>
                    </ul>
                </li>
            }

            <!-- PRODUCTION MODULE (Admin, Manager) -->
            @if (TEXCEL_ERP.Helpers.SessionHelper.CanEdit)
            {
                <li class="nav-item has-dropdown">
                    <a href="javascript:void(0);" class="nav-link">
                        <i class="fas fa-cogs"></i> Production
                    </a>
                    <ul class="dropdown-menu">
                        <li><a href="@Url.Action("Index", "Production")"><i class="fas fa-clipboard-list"></i> Production Plans</a></li>
                        <li><a href="@Url.Action("Cutting", "Production")"><i class="fas fa-cut"></i> Cutting</a></li>
                        <li><a href="@Url.Action("Sewing", "Production")"><i class="fas fa-tshirt"></i> Sewing</a></li>
                        <li><a href="@Url.Action("Finishing", "Production")"><i class="fas fa-check-double"></i> Finishing</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a href="@Url.Action("Index", "Quality")"><i class="fas fa-award"></i> Quality Control</a></li>
                    </ul>
                </li>
            }

            <!-- SALES MODULE (Admin, Manager) -->
            @if (TEXCEL_ERP.Helpers.SessionHelper.CanEdit)
            {
                <li class="nav-item has-dropdown">
                    <a href="javascript:void(0);" class="nav-link">
                        <i class="fas fa-chart-line"></i> Sales
                    </a>
                    <ul class="dropdown-menu">
                        <li><a href="@Url.Action("Index", "Customer")"><i class="fas fa-user-friends"></i> Customers</a></li>
                        <li><a href="@Url.Action("Index", "Sales")"><i class="fas fa-file-invoice"></i> Sales Orders</a></li>
                        <li><a href="@Url.Action("Invoice", "Sales")"><i class="fas fa-receipt"></i> Invoices</a></li>
                        <li><a href="@Url.Action("Dispatch", "Sales")"><i class="fas fa-shipping-fast"></i> Dispatch</a></li>
                    </ul>
                </li>
            }

            <!-- ANALYTICS (Admin, Manager) -->
            @if (TEXCEL_ERP.Helpers.SessionHelper.CanEdit)
            {
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Report")" class="nav-link">
                        <i class="fas fa-chart-bar"></i> Analytics
                    </a>
                </li>
            }

            <!-- ADMIN DROPDOWN (SuperAdmin Only) -->
            @if (TEXCEL_ERP.Helpers.SessionHelper.IsSuperAdmin)
            {
                <li class="nav-item has-dropdown">
                    <a href="javascript:void(0);" class="nav-link">
                        <i class="fas fa-building"></i> Admin
                    </a>
                    <ul class="dropdown-menu">
                        <li><a href="@Url.Action("Index", "Branch")"><i class="fas fa-building"></i> Branches</a></li>
                        <li><a href="@Url.Action("Index", "User")"><i class="fas fa-user-shield"></i> Users</a></li>
                        <li><a href="@Url.Action("Index", "Company")"><i class="fas fa-briefcase"></i> Company Info</a></li>
                    </ul>
                </li>
            }

            <!-- SETTINGS (Admin Only) -->
            @if (TEXCEL_ERP.Helpers.SessionHelper.IsAdmin)
            {
                <li class="nav-item has-dropdown">
                    <a href="javascript:void(0);" class="nav-link">
                        <i class="fas fa-cog"></i> Settings
                    </a>
                    <ul class="dropdown-menu" style="right:0; left:auto;">
                        <li><a href="@Url.Action("Index", "Settings")"><i class="fas fa-sliders-h"></i> General Settings</a></li>
                        <li><a href="@Url.Action("Index", "Settings")"><i class="fas fa-bell"></i> Notifications</a></li>
                        <li><a href="@Url.Action("ChangePassword", "Account")"><i class="fas fa-key"></i> Change Password</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a href="@Url.Action("Index", "Help")"><i class="fas fa-question-circle"></i> Help &amp; Support</a></li>
                    </ul>
                </li>
            }

        </ul>

        <div class="navbar-right">
            <button class="btn-icon" id="themeToggle" title="Toggle Theme">
                <i class="fas fa-moon" id="themeIcon"></i>
            </button>

            @{
                // =============================================
                // NULL-SAFE USER INFO — Ek hi jagah declare
                // =============================================
                var displayName = !string.IsNullOrWhiteSpace(SessionHelper.FullName)
                    ? SessionHelper.FullName
                    : (!string.IsNullOrWhiteSpace(User.Identity.Name) ? User.Identity.Name : "Guest");

                var displayRole = !string.IsNullOrWhiteSpace(SessionHelper.Role)
                    ? SessionHelper.Role
                    : "User";

                var avatarLetter = !string.IsNullOrWhiteSpace(displayName)
                    ? displayName.Substring(0, 1).ToUpper()
                    : "U";
            }

            <!-- User Avatar with Dropdown -->
            <div class="user-profile-wrapper">
                <a href="javascript:void(0);" class="user-avatar-btn" id="userProfileBtn" title="@displayName">
                    @avatarLetter
                </a>

                <!-- User Dropdown -->
                <div class="user-dropdown" id="userDropdown">
                    <div class="user-dropdown-header">
                        <div class="user-avatar-lg">
                            @avatarLetter
                        </div>
                        <div class="user-dropdown-info">
                            <h4>@displayName</h4>
                            <p>@displayRole</p>
                        </div>
                    </div>

                    <div class="user-dropdown-divider"></div>

                    <a href="@Url.Action("ChangePassword", "Account")" class="user-dropdown-item">
                        <i class="fas fa-key"></i> Change Password
                    </a>
                    <a href="@Url.Action("Index", "Settings")" class="user-dropdown-item">
                        <i class="fas fa-cog"></i> Settings
                    </a>
                    <a href="@Url.Action("Index", "Help")" class="user-dropdown-item">
                        <i class="fas fa-question-circle"></i> Help &amp; Support
                    </a>

                    <div class="user-dropdown-divider"></div>

                    @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { @id = "logoutForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="user-dropdown-item logout-btn">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </button>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- ============================================= -->
    <!-- PAGE CONTENT                                  -->
    <!-- ============================================= -->
    <div class="page-content">
        @RenderBody()
    </div>

    <!-- ============================================= -->
    <!-- FOOTER                                        -->
    <!-- ============================================= -->
    <div class="footer">
        © 2026 <strong>TEXCEL ERP™</strong> — Textile &amp; Garment ERP System
        <span style="margin:0 12px;">•</span>
        <i class="far fa-clock"></i> <span id="currentTime"></span>
        <span style="margin:0 12px;">•</span>
        <span class="version-badge">v3.0 Premium</span>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/dashboard.js"></script>
    <script src="~/Scripts/common.js"></script>

    @RenderSection("scripts", required: false)

</body>
</html>