@model TEXCEL_ERP.Models.ViewModels.GraphAnalyticsViewModel
@{
    ViewBag.Title = "Graph Analytics";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var isSuperAdmin = ViewBag.IsSuperAdmin != null && (bool)ViewBag.IsSuperAdmin;
    var selectedBranchId = ViewBag.SelectedBranchId as int?;

    var months = new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun",
                         "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };

    // KPIs derived from charts
    var totalPresent = Model.StatusDistributionChart != null && Model.StatusDistributionChart.Count > 0
        ? Model.StatusDistributionChart[0].Value : 0;
    var totalAbsent = Model.StatusDistributionChart != null && Model.StatusDistributionChart.Count > 1
        ? Model.StatusDistributionChart[1].Value : 0;
    var totalLeave = Model.StatusDistributionChart != null && Model.StatusDistributionChart.Count > 2
        ? Model.StatusDistributionChart[2].Value : 0;

    var totalRecords = totalPresent + totalAbsent + totalLeave;
    var attendancePct = totalRecords > 0 ? Math.Round(totalPresent / totalRecords * 100, 1) : 0;
}

@section styles {
    <style>
        /* ============================================= */
        /* GRAPH ANALYTICS — PLUM THEME                  */
        /* ============================================= */

        .page-header-graphs {
            background: linear-gradient(135deg, #7c3aed, #a855f7);
            border-radius: 16px;
            padding: 20px 24px;
            margin-bottom: 24px;
            color: white;
            box-shadow: 0 8px 24px rgba(124, 58, 237, 0.30);
            display: flex;
            align-items: center;
            gap: 16px;
        }

            .page-header-graphs .header-icon {
                width: 48px;
                height: 48px;
                border-radius: 12px;
                background: rgba(255, 255, 255, 0.20);
                backdrop-filter: blur(10px);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                color: white;
                flex-shrink: 0;
            }

            .page-header-graphs h1 {
                font-size: 20px;
                font-weight: 800;
                font-family: 'Space Grotesk', sans-serif;
                margin: 0;
                color: white;
            }

            .page-header-graphs p {
                font-size: 12px;
                margin: 4px 0 0 0;
                color: rgba(255, 255, 255, 0.85);
            }

        .page-back-btn {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.20);
            backdrop-filter: blur(10px);
            border: 1.5px solid rgba(255, 255, 255, 0.35);
            color: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 16px;
            transition: all 0.3s;
            flex-shrink: 0;
        }

            .page-back-btn:hover {
                background: rgba(255, 255, 255, 0.35);
                border-color: rgba(255, 255, 255, 0.60);
                color: white;
                text-decoration: none;
                transform: translateX(-4px);
            }

        /* Filter */
        .filter-bar {
            background: var(--bg-card);
            border-radius: 14px;
            padding: 16px 20px;
            border: 1px solid var(--border-color);
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            box-shadow: 0 4px 16px rgba(124, 58, 237, 0.05);
        }

            .filter-bar .filter-title {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 13px;
                font-weight: 700;
                color: var(--text-primary);
                padding-right: 14px;
                border-right: 1px solid var(--border-color);
                margin-right: 4px;
            }

                .filter-bar .filter-title i {
                    color: #7c3aed;
                }

        .filter-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .filter-group label {
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: var(--text-secondary);
                white-space: nowrap;
            }

            .filter-group input,
            .filter-group select {
                padding: 9px 14px;
                border-radius: 8px;
                border: 1.5px solid var(--border-color);
                background: var(--bg-body);
                color: var(--text-primary);
                font-size: 13px;
                font-weight: 600;
                outline: none;
                font-family: 'Inter', sans-serif;
                transition: all 0.3s;
                min-width: 120px;
            }

                .filter-group input:focus,
                .filter-group select:focus {
                    border-color: #7c3aed;
                    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.10);
                }

        .btn-generate {
            padding: 9px 20px;
            border-radius: 8px;
            background: linear-gradient(135deg, #7c3aed, #a855f7);
            color: white;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-size: 13px;
            font-family: 'Inter', sans-serif;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 12px rgba(124, 58, 237, 0.30);
            transition: all 0.3s;
            white-space: nowrap;
        }

            .btn-generate:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 16px rgba(124, 58, 237, 0.40);
            }

        /* KPI */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 14px;
            margin-bottom: 24px;
        }

        .kpi-card {
            background: var(--bg-card);
            border-radius: 14px;
            padding: 18px 16px;
            border: 1px solid var(--border-color);
            text-align: center;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

            .kpi-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
            }

            .kpi-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
            }

            .kpi-card .kpi-icon {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
                margin-bottom: 10px;
            }

            .kpi-card .kpi-value {
                font-size: 22px;
                font-weight: 800;
                font-family: 'Space Grotesk', sans-serif;
                line-height: 1;
                margin-bottom: 6px;
            }

            .kpi-card .kpi-label {
                font-size: 10px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: var(--text-secondary);
            }

        .kpi-emp::before {
            background: #7c3aed;
        }

        .kpi-emp .kpi-icon {
            background: rgba(124, 58, 237, 0.12);
            color: #7c3aed;
        }

        .kpi-emp .kpi-value {
            color: #7c3aed;
        }

        .kpi-present::before {
            background: #10b981;
        }

        .kpi-present .kpi-icon {
            background: rgba(16, 185, 129, 0.12);
            color: #10b981;
        }

        .kpi-present .kpi-value {
            color: #10b981;
        }

        .kpi-absent::before {
            background: #ef4444;
        }

        .kpi-absent .kpi-icon {
            background: rgba(239, 68, 68, 0.10);
            color: #ef4444;
        }

        .kpi-absent .kpi-value {
            color: #ef4444;
        }

        .kpi-leave::before {
            background: #3b82f6;
        }

        .kpi-leave .kpi-icon {
            background: rgba(59, 130, 246, 0.12);
            color: #3b82f6;
        }

        .kpi-leave .kpi-value {
            color: #3b82f6;
        }

        .kpi-pct::before {
            background: #a855f7;
        }

        .kpi-pct .kpi-icon {
            background: rgba(168, 85, 247, 0.12);
            color: #a855f7;
        }

        .kpi-pct .kpi-value {
            color: #a855f7;
        }

        .kpi-records::before {
            background: #8b5cf6;
        }

        .kpi-records .kpi-icon {
            background: rgba(139, 92, 246, 0.12);
            color: #8b5cf6;
        }

        .kpi-records .kpi-value {
            color: #8b5cf6;
        }

        /* Charts */
        .charts-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .charts-grid-3 {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        .chart-card {
            background: var(--bg-card);
            border-radius: 14px;
            padding: 20px 24px;
            border: 1px solid var(--border-color);
            box-shadow: 0 4px 16px rgba(124, 58, 237, 0.05);
        }

            .chart-card h3 {
                font-size: 14px;
                font-weight: 700;
                font-family: 'Space Grotesk', sans-serif;
                color: var(--text-primary);
                margin: 0 0 16px 0;
                padding-bottom: 12px;
                border-bottom: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .chart-card h3 i {
                    color: #7c3aed;
                }

            .chart-card .chart-container {
                position: relative;
                height: 300px;
            }

            .chart-card.chart-tall .chart-container {
                height: 420px;
            }

        /* Export */
        .export-bar {
            background: var(--bg-card);
            border-radius: 14px;
            padding: 16px 24px;
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

            .export-bar .export-title {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 13px;
                font-weight: 700;
                color: var(--text-primary);
            }

                .export-bar .export-title i {
                    color: #7c3aed;
                }

            .export-bar .export-buttons {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
            }

        .btn-export {
            padding: 9px 18px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 12px;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.3s;
            border: none;
            text-decoration: none;
        }

            .btn-export:hover {
                transform: translateY(-1px);
            }

        .btn-print {
            background: rgba(107, 114, 128, 0.12);
            color: #4b5563;
        }

            .btn-print:hover {
                background: rgba(107, 114, 128, 0.20);
            }

        .btn-pdf {
            background: rgba(239, 68, 68, 0.10);
            color: #ef4444;
        }

            .btn-pdf:hover {
                background: rgba(239, 68, 68, 0.18);
            }

        .btn-excel {
            background: rgba(16, 185, 129, 0.12);
            color: #10b981;
        }

            .btn-excel:hover {
                background: rgba(16, 185, 129, 0.20);
            }

        .btn-csv {
            background: rgba(59, 130, 246, 0.12);
            color: #3b82f6;
        }

            .btn-csv:hover {
                background: rgba(59, 130, 246, 0.20);
            }

        @@media (max-width: 1200px) {
            .kpi-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .charts-grid-2, .charts-grid-3 {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 700px) {
            .kpi-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .filter-bar {
                flex-direction: column;
                align-items: stretch;
            }

                .filter-bar .filter-title {
                    border-right: none;
                    border-bottom: 1px solid var(--border-color);
                    padding-right: 0;
                    padding-bottom: 10px;
                    margin-right: 0;
                }

            .filter-group {
                justify-content: space-between;
            }

                .filter-group input, .filter-group select {
                    flex: 1;
                }
        }

        @@media print {
            .page-header-graphs, .filter-bar, .export-bar, .page-back-btn,
            .top-navbar, .footer, .report-subnav {
                display: none !important;
            }

            .kpi-grid {
                grid-template-columns: repeat(6, 1fr);
            }

            .chart-card {
                page-break-inside: avoid;
            }

            body {
                background: white !important;
            }
        }
    </style>
}

<!-- SUB-NAV -->
@Html.Partial("_ReportNav")

<!-- HEADER -->
<div class="page-header-graphs">
    <a href="@Url.Action("Index", "AttendanceReport")" class="page-back-btn" title="Back to Reports">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div class="header-icon">
        <i class="fas fa-chart-line"></i>
    </div>
    <div>
        <h1>Graph Analytics</h1>
        <p>
            @Model.MonthName
            <span> • </span>
            <span>@Model.BranchName</span>
            <span> • </span>
            <span>Visual insights &amp; trends</span>
        </p>
    </div>
</div>

<!-- FILTER -->
<div class="filter-bar">
    <div class="filter-title">
        <i class="fas fa-filter"></i>
        <span>Filter</span>
    </div>

    <form method="get" action="@Url.Action("Graphs", "AttendanceReport")" style="display: contents;">
        <div class="filter-group">
            <label>Month</label>
            <select name="month">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" @(Model.Month == m ? "selected" : "")>@months[m - 1]</option>
                }
            </select>
        </div>

        <div class="filter-group">
            <label>Year</label>
            <select name="year">
                @for (int y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 1; y++)
                {
                    <option value="@y" @(Model.Year == y ? "selected" : "")>@y</option>
                }
            </select>
        </div>

        @if (isSuperAdmin)
        {
            <div class="filter-group">
                <label>Branch</label>
                <select name="branchId">
                    <option value="">All Branches</option>
                    @if (Model.Branches != null)
                    {
                        foreach (var b in Model.Branches)
                        {
                            <option value="@b.BranchId" @(selectedBranchId == b.BranchId ? "selected" : "")>@b.BranchName</option>
                        }
                    }
                </select>
            </div>
        }

        <button type="submit" class="btn-generate">
            <i class="fas fa-sync-alt"></i> Generate
        </button>
    </form>
</div>

<!-- KPI -->
<div class="kpi-grid">
    <div class="kpi-card kpi-emp">
        <div class="kpi-icon"><i class="fas fa-users"></i></div>
        <div class="kpi-value">@Model.EmployeePresentChart.Count</div>
        <div class="kpi-label">Employees</div>
    </div>

    <div class="kpi-card kpi-present">
        <div class="kpi-icon"><i class="fas fa-user-check"></i></div>
        <div class="kpi-value">@totalPresent</div>
        <div class="kpi-label">Present</div>
    </div>

    <div class="kpi-card kpi-absent">
        <div class="kpi-icon"><i class="fas fa-user-times"></i></div>
        <div class="kpi-value">@totalAbsent</div>
        <div class="kpi-label">Absent</div>
    </div>

    <div class="kpi-card kpi-leave">
        <div class="kpi-icon"><i class="fas fa-plane-departure"></i></div>
        <div class="kpi-value">@totalLeave</div>
        <div class="kpi-label">Leave</div>
    </div>

    <div class="kpi-card kpi-pct">
        <div class="kpi-icon"><i class="fas fa-percentage"></i></div>
        <div class="kpi-value">@attendancePct%</div>
        <div class="kpi-label">Attendance</div>
    </div>

    <div class="kpi-card kpi-records">
        <div class="kpi-icon"><i class="fas fa-database"></i></div>
        <div class="kpi-value">@totalRecords</div>
        <div class="kpi-label">Total Records</div>
    </div>
</div>

<!-- ROW 1: Employee Present Bar + Monthly Trend Line -->
<div class="charts-grid-2">

    <div class="chart-card">
        <h3><i class="fas fa-chart-bar"></i> Employee-wise Present Days</h3>
        <div class="chart-container">
            <canvas id="employeePresentChart"></canvas>
        </div>
    </div>

    <div class="chart-card">
        <h3><i class="fas fa-chart-line"></i> Monthly Trend (@Model.Year)</h3>
        <div class="chart-container">
            <canvas id="monthlyTrendChart"></canvas>
        </div>
    </div>

</div>

<!-- ROW 2: Status Pie + Dept Comparison Stacked Bar -->
<div class="charts-grid-3">

    <div class="chart-card chart-tall">
        <h3><i class="fas fa-chart-bar"></i> Department Comparison</h3>
        <div class="chart-container">
            <canvas id="deptComparisonChart"></canvas>
        </div>
    </div>

    <div class="chart-card chart-tall">
        <h3><i class="fas fa-chart-pie"></i> Status Distribution</h3>
        <div class="chart-container">
            <canvas id="statusDistributionChart"></canvas>
        </div>
    </div>

</div>

<!-- EXPORT -->
<div class="export-bar">
    <div class="export-title">
        <i class="fas fa-download"></i>
        <span>Export Charts</span>
    </div>
    <div class="export-buttons">
        <button type="button" class="btn-export btn-print" onclick="window.print();">
            <i class="fas fa-print"></i> Print / Save as PDF
        </button>
    </div>
</div>

<!-- CHART DATA -->
<script id="employeePresentChartData" type="application/json">
    @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.EmployeePresentChart))
</script>

<script id="monthlyTrendChartData" type="application/json">
    @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlyTrendChart))
</script>

<script id="statusDistributionChartData" type="application/json">
    @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.StatusDistributionChart))
</script>

<script id="deptComparisonChartData" type="application/json">
    @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.DepartmentComparisonChart))
</script>

<script id="deptComparisonLabels" type="application/json">
    @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.DepartmentComparisonLabels))
</script>

<script id="deptComparisonSeries" type="application/json">
    @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.DepartmentComparisonSeries))
</script>

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <script src="~/Scripts/attendance-reports.js"></script>
}