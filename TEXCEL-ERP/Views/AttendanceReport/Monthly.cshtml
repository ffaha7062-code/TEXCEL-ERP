@model TEXCEL_ERP.Models.ViewModels.MonthlySummaryReportViewModel
@{
    ViewBag.Title = "Monthly Summary Report";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var isSuperAdmin = ViewBag.IsSuperAdmin != null && (bool)ViewBag.IsSuperAdmin;
    var selectedBranchId = ViewBag.SelectedBranchId as int?;
    var selectedDepartmentId = ViewBag.SelectedDepartmentId as int?;

    var months = new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun",
                         "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
}

@section styles {
    <style>
        /* ============================================= */
        /* MONTHLY REPORT — BURGUNDY THEME               */
        /* ============================================= */

        /* PAGE HEADER */
        .page-header-monthly {
            background: linear-gradient(135deg, #a1556d, #7c3a4d);
            border-radius: 16px;
            padding: 20px 24px;
            margin-bottom: 24px;
            color: white;
            box-shadow: 0 8px 24px rgba(161, 85, 109, 0.30);
            display: flex;
            align-items: center;
            gap: 16px;
        }

            .page-header-monthly .header-icon {
                width: 48px;
                height: 48px;
                border-radius: 12px;
                background: rgba(255, 255, 255, 0.20);
                backdrop-filter: blur(10px);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                color: white;
                flex-shrink: 0;
            }

            .page-header-monthly h1 {
                font-size: 20px;
                font-weight: 800;
                font-family: 'Space Grotesk', sans-serif;
                margin: 0;
                color: white;
            }

            .page-header-monthly p {
                font-size: 12px;
                margin: 4px 0 0 0;
                color: rgba(255, 255, 255, 0.85);
            }

        /* Back Button */
        .page-back-btn {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.20);
            backdrop-filter: blur(10px);
            border: 1.5px solid rgba(255, 255, 255, 0.35);
            color: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 16px;
            transition: all 0.3s;
            flex-shrink: 0;
        }

            .page-back-btn:hover {
                background: rgba(255, 255, 255, 0.35);
                border-color: rgba(255, 255, 255, 0.60);
                color: white;
                text-decoration: none;
                transform: translateX(-4px);
            }

        /* ============================================= */
        /* FILTER BAR                                     */
        /* ============================================= */
        .filter-bar {
            background: var(--bg-card);
            border-radius: 14px;
            padding: 16px 20px;
            border: 1px solid var(--border-color);
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            box-shadow: 0 4px 16px rgba(161, 85, 109, 0.05);
        }

            .filter-bar .filter-title {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 13px;
                font-weight: 700;
                color: var(--text-primary);
                padding-right: 14px;
                border-right: 1px solid var(--border-color);
                margin-right: 4px;
            }

                .filter-bar .filter-title i {
                    color: #a1556d;
                }

        .filter-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .filter-group label {
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: var(--text-secondary);
                white-space: nowrap;
            }

            .filter-group input,
            .filter-group select {
                padding: 9px 14px;
                border-radius: 8px;
                border: 1.5px solid var(--border-color);
                background: var(--bg-body);
                color: var(--text-primary);
                font-size: 13px;
                font-weight: 600;
                outline: none;
                font-family: 'Inter', sans-serif;
                transition: all 0.3s;
                min-width: 120px;
            }

                .filter-group input:focus,
                .filter-group select:focus {
                    border-color: #a1556d;
                    box-shadow: 0 0 0 3px rgba(161, 85, 109, 0.10);
                }

        .btn-generate {
            padding: 9px 20px;
            border-radius: 8px;
            background: linear-gradient(135deg, #a1556d, #7c3a4d);
            color: white;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-size: 13px;
            font-family: 'Inter', sans-serif;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 12px rgba(161, 85, 109, 0.30);
            transition: all 0.3s;
            white-space: nowrap;
        }

            .btn-generate:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 16px rgba(161, 85, 109, 0.40);
            }

        /* ============================================= */
        /* KPI CARDS                                      */
        /* ============================================= */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 14px;
            margin-bottom: 24px;
        }

        .kpi-card {
            background: var(--bg-card);
            border-radius: 14px;
            padding: 18px 16px;
            border: 1px solid var(--border-color);
            text-align: center;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

            .kpi-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
            }

            .kpi-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
            }

            .kpi-card .kpi-icon {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
                margin-bottom: 10px;
            }

            .kpi-card .kpi-value {
                font-size: 22px;
                font-weight: 800;
                font-family: 'Space Grotesk', sans-serif;
                line-height: 1;
                margin-bottom: 6px;
            }

            .kpi-card .kpi-label {
                font-size: 10px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: var(--text-secondary);
            }

        .kpi-emp::before {
            background: #a1556d;
        }

        .kpi-emp .kpi-icon {
            background: rgba(161, 85, 109, 0.12);
            color: #a1556d;
        }

        .kpi-emp .kpi-value {
            color: #a1556d;
        }

        .kpi-present::before {
            background: #10b981;
        }

        .kpi-present .kpi-icon {
            background: rgba(16, 185, 129, 0.12);
            color: #10b981;
        }

        .kpi-present .kpi-value {
            color: #10b981;
        }

        .kpi-absent::before {
            background: #ef4444;
        }

        .kpi-absent .kpi-icon {
            background: rgba(239, 68, 68, 0.10);
            color: #ef4444;
        }

        .kpi-absent .kpi-value {
            color: #ef4444;
        }

        .kpi-leave::before {
            background: #3b82f6;
        }

        .kpi-leave .kpi-icon {
            background: rgba(59, 130, 246, 0.12);
            color: #3b82f6;
        }

        .kpi-leave .kpi-value {
            color: #3b82f6;
        }

        .kpi-ot::before {
            background: #f59e0b;
        }

        .kpi-ot .kpi-icon {
            background: rgba(245, 158, 11, 0.12);
            color: #f59e0b;
        }

        .kpi-ot .kpi-value {
            color: #f59e0b;
        }

        .kpi-percent::before {
            background: #7c3a4d;
        }

        .kpi-percent .kpi-icon {
            background: rgba(124, 58, 77, 0.12);
            color: #7c3a4d;
        }

        .kpi-percent .kpi-value {
            color: #7c3a4d;
        }

        /* ============================================= */
        /* CHARTS                                         */
        /* ============================================= */
        .charts-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        .chart-card {
            background: var(--bg-card);
            border-radius: 14px;
            padding: 20px 24px;
            border: 1px solid var(--border-color);
            box-shadow: 0 4px 16px rgba(161, 85, 109, 0.05);
        }

            .chart-card h3 {
                font-size: 14px;
                font-weight: 700;
                font-family: 'Space Grotesk', sans-serif;
                color: var(--text-primary);
                margin: 0 0 16px 0;
                padding-bottom: 12px;
                border-bottom: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .chart-card h3 i {
                    color: #a1556d;
                }

            .chart-card .chart-container {
                position: relative;
                height: 300px;
            }

        /* ============================================= */
        /* TABLE CARD                                     */
        /* ============================================= */
        .table-card {
            background: var(--bg-card);
            border-radius: 14px;
            border: 1px solid var(--border-color);
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(161, 85, 109, 0.05);
            margin-bottom: 24px;
        }

        .table-header {
            padding: 16px 24px;
            background: rgba(161, 85, 109, 0.04);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }

            .table-header h3 {
                margin: 0;
                font-size: 14px;
                font-weight: 700;
                font-family: 'Space Grotesk', sans-serif;
                color: var(--text-primary);
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .table-header h3 i {
                    color: #a1556d;
                }

            .table-header .record-count {
                font-size: 12px;
                color: var(--text-secondary);
                font-weight: 600;
            }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

            .data-table thead {
                background: rgba(161, 85, 109, 0.03);
            }

            .data-table th {
                padding: 12px 14px;
                text-align: left;
                font-size: 10px;
                font-weight: 700;
                color: var(--text-secondary);
                text-transform: uppercase;
                letter-spacing: 0.5px;
                border-bottom: 1px solid var(--border-color);
                white-space: nowrap;
            }

            .data-table td {
                padding: 12px 14px;
                font-size: 12px;
                color: var(--text-primary);
                border-bottom: 1px solid var(--border-color);
            }

            .data-table tbody tr:hover {
                background: rgba(161, 85, 109, 0.03);
            }

            .data-table tr:last-child td {
                border-bottom: none;
            }

        .emp-mini {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .emp-mini .emp-avatar {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: linear-gradient(135deg, #a1556d, #7c3a4d);
                color: white;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 12px;
                flex-shrink: 0;
            }

            .emp-mini .emp-name {
                font-weight: 600;
                font-size: 13px;
                color: var(--text-primary);
                display: block;
            }

            .emp-mini .emp-code {
                font-size: 10px;
                color: var(--text-muted);
                display: block;
            }

        /* Status mini badges in table */
        .badge-count {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            min-width: 32px;
            text-align: center;
        }

        .badge-green {
            background: rgba(16, 185, 129, 0.12);
            color: #10b981;
        }

        .badge-red {
            background: rgba(239, 68, 68, 0.10);
            color: #ef4444;
        }

        .badge-blue {
            background: rgba(59, 130, 246, 0.12);
            color: #3b82f6;
        }

        .badge-amber {
            background: rgba(245, 158, 11, 0.12);
            color: #f59e0b;
        }

        .badge-purple {
            background: rgba(139, 92, 246, 0.12);
            color: #8b5cf6;
        }

        .text-ot {
            color: #10b981;
            font-weight: 600;
        }

        .text-less {
            color: #ef4444;
            font-weight: 600;
        }

        .text-late {
            color: #a1556d;
            font-weight: 600;
        }

        /* Percentage bar */
        .pct-bar {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .pct-track {
            flex: 1;
            height: 6px;
            background: rgba(0, 0, 0, 0.06);
            border-radius: 3px;
            overflow: hidden;
            min-width: 60px;
        }

        .pct-fill {
            height: 100%;
            background: linear-gradient(90deg, #a1556d, #7c3a4d);
            border-radius: 3px;
            transition: width 0.5s ease;
        }

            .pct-fill.low {
                background: linear-gradient(90deg, #ef4444, #dc2626);
            }

            .pct-fill.medium {
                background: linear-gradient(90deg, #f59e0b, #d97706);
            }

            .pct-fill.high {
                background: linear-gradient(90deg, #10b981, #059669);
            }

        .pct-text {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-primary);
            min-width: 45px;
            text-align: right;
        }

        /* ============================================= */
        /* EXPORT BAR                                     */
        /* ============================================= */
        .export-bar {
            background: var(--bg-card);
            border-radius: 14px;
            padding: 16px 24px;
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

            .export-bar .export-title {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 13px;
                font-weight: 700;
                color: var(--text-primary);
            }

                .export-bar .export-title i {
                    color: #a1556d;
                }

            .export-bar .export-buttons {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
            }

        .btn-export {
            padding: 9px 18px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 12px;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.3s;
            border: none;
            text-decoration: none;
        }

            .btn-export:hover {
                transform: translateY(-1px);
            }

        .btn-print {
            background: rgba(107, 114, 128, 0.12);
            color: #4b5563;
        }

            .btn-print:hover {
                background: rgba(107, 114, 128, 0.20);
            }

        .btn-pdf {
            background: rgba(239, 68, 68, 0.10);
            color: #ef4444;
        }

            .btn-pdf:hover {
                background: rgba(239, 68, 68, 0.18);
            }

        .btn-excel {
            background: rgba(16, 185, 129, 0.12);
            color: #10b981;
        }

            .btn-excel:hover {
                background: rgba(16, 185, 129, 0.20);
            }

        .btn-csv {
            background: rgba(59, 130, 246, 0.12);
            color: #3b82f6;
        }

            .btn-csv:hover {
                background: rgba(59, 130, 246, 0.20);
            }

        /* ============================================= */
        /* RESPONSIVE                                     */
        /* ============================================= */
        @@media (max-width: 1200px) {
            .kpi-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .charts-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 700px) {
            .kpi-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .filter-bar {
                flex-direction: column;
                align-items: stretch;
            }

                .filter-bar .filter-title {
                    border-right: none;
                    border-bottom: 1px solid var(--border-color);
                    padding-right: 0;
                    padding-bottom: 10px;
                    margin-right: 0;
                }

            .filter-group {
                justify-content: space-between;
            }

                .filter-group input,
                .filter-group select {
                    flex: 1;
                }
        }

        /* Print */
        @@media print {
            .page-header-monthly,
            .filter-bar,
            .export-bar,
            .page-back-btn,
            .top-navbar,
            .footer,
            .report-subnav {
                display: none !important;
            }

            .kpi-grid {
                grid-template-columns: repeat(6, 1fr);
            }

            .chart-card {
                page-break-inside: avoid;
            }

            body {
                background: white !important;
            }
        }
    </style>
}

<!-- ============================================= -->
<!-- SUB-NAV                                        -->
<!-- ============================================= -->
@Html.Partial("_ReportNav")

<!-- ============================================= -->
<!-- COMPACT HEADER                                 -->
<!-- ============================================= -->
<div class="page-header-monthly">
    <a href="@Url.Action("Index", "AttendanceReport")" class="page-back-btn" title="Back to Reports">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div class="header-icon">
        <i class="fas fa-calendar-check"></i>
    </div>
    <div>
        <h1>Monthly Summary Report</h1>
        <p>
            @Model.MonthName
            <span> • </span>
            <span>@Model.BranchName</span>
            @if (!string.IsNullOrEmpty(Model.DepartmentName))
            {
                <span> • </span>
                <span>@Model.DepartmentName</span>
            }
        </p>
    </div>
</div>

<!-- ============================================= -->
<!-- FILTER BAR                                     -->
<!-- ============================================= -->
<div class="filter-bar">
    <div class="filter-title">
        <i class="fas fa-filter"></i>
        <span>Filter</span>
    </div>

    <form method="get" action="@Url.Action("Monthly", "AttendanceReport")" style="display: contents;">
        <div class="filter-group">
            <label>Month</label>
            <select name="month">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" @(Model.Month == m ? "selected" : "")>@months[m - 1]</option>
                }
            </select>
        </div>

        <div class="filter-group">
            <label>Year</label>
            <select name="year">
                @for (int y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 1; y++)
                {
                    <option value="@y" @(Model.Year == y ? "selected" : "")>@y</option>
                }
            </select>
        </div>

        @if (isSuperAdmin)
        {
            <div class="filter-group">
                <label>Branch</label>
                <select name="branchId">
                    <option value="">All Branches</option>
                    @if (Model.Branches != null)
                    {
                        foreach (var b in Model.Branches)
                        {
                            <option value="@b.BranchId" @(selectedBranchId == b.BranchId ? "selected" : "")>@b.BranchName</option>
                        }
                    }
                </select>
            </div>
        }

        <div class="filter-group">
            <label>Department</label>
            <select name="departmentId">
                <option value="">All Departments</option>
                @if (Model.Departments != null)
                {
                    foreach (var d in Model.Departments)
                    {
                        <option value="@d.DepartmentId" @(selectedDepartmentId == d.DepartmentId ? "selected" : "")>@d.DepartmentName</option>
                    }
                }
            </select>
        </div>

        <button type="submit" class="btn-generate">
            <i class="fas fa-sync-alt"></i> Generate Report
        </button>
    </form>
</div>

<!-- ============================================= -->
<!-- KPI CARDS                                      -->
<!-- ============================================= -->
<div class="kpi-grid">
    <div class="kpi-card kpi-emp">
        <div class="kpi-icon"><i class="fas fa-users"></i></div>
        <div class="kpi-value">@Model.TotalEmployees</div>
        <div class="kpi-label">Employees</div>
    </div>

    <div class="kpi-card kpi-present">
        <div class="kpi-icon"><i class="fas fa-user-check"></i></div>
        <div class="kpi-value">@Model.TotalPresentDays</div>
        <div class="kpi-label">Present Days</div>
    </div>

    <div class="kpi-card kpi-absent">
        <div class="kpi-icon"><i class="fas fa-user-times"></i></div>
        <div class="kpi-value">@Model.TotalAbsentDays</div>
        <div class="kpi-label">Absent Days</div>
    </div>

    <div class="kpi-card kpi-leave">
        <div class="kpi-icon"><i class="fas fa-plane-departure"></i></div>
        <div class="kpi-value">@Model.TotalLeaveDays</div>
        <div class="kpi-label">Leave Days</div>
    </div>

    <div class="kpi-card kpi-ot">
        <div class="kpi-icon"><i class="fas fa-clock"></i></div>
        <div class="kpi-value">@Model.TotalOvertimeHours.ToString("0.0")</div>
        <div class="kpi-label">OT Hours</div>
    </div>

    <div class="kpi-card kpi-percent">
        <div class="kpi-icon"><i class="fas fa-percentage"></i></div>
        <div class="kpi-value">@Model.AverageAttendancePercentage%</div>
        <div class="kpi-label">Avg Attendance</div>
    </div>
</div>

<!-- ============================================= -->
<!-- CHARTS                                         -->
<!-- ============================================= -->
<div class="charts-grid">

    <div class="chart-card">
        <h3><i class="fas fa-trophy"></i> Top 5 Present Employees</h3>
        <div class="chart-container">
            <canvas id="topPresentChart"></canvas>
        </div>
    </div>

    <div class="chart-card">
        <h3><i class="fas fa-fire"></i> Top 5 Overtime Employees</h3>
        <div class="chart-container">
            <canvas id="topOTChart"></canvas>
        </div>
    </div>

</div>

<!-- ============================================= -->
<!-- DATA TABLE                                     -->
<!-- ============================================= -->
<div class="table-card">
    <div class="table-header">
        <h3><i class="fas fa-list"></i> Employee-wise Monthly Summary</h3>
        <div class="record-count">
            <i class="fas fa-database"></i> @Model.EmployeeSummaries.Count Employees
        </div>
    </div>

    @if (Model.EmployeeSummaries != null && Model.EmployeeSummaries.Any())
    {
        <div style="overflow-x: auto;">
            <table class="data-table" id="monthlyReportTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>Shift</th>
                        <th>Present</th>
                        <th>Absent</th>
                        <th>Leave</th>
                        <th>Half</th>
                        <th>Late</th>
                        <th>Worked</th>
                        <th>OT</th>
                        <th>Less</th>
                        <th>Attendance %</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNo = 1; }
                    @foreach (var row in Model.EmployeeSummaries)
                    {
                        var initial = !string.IsNullOrEmpty(row.EmployeeName) ? row.EmployeeName.Substring(0, 1).ToUpper() : "E";
                        var pctClass = row.AttendancePercentage >= 90 ? "high" : (row.AttendancePercentage >= 75 ? "medium" : "low");

                        <tr>
                            <td>@rowNo</td>
                            <td>
                                <div class="emp-mini">
                                    <span class="emp-avatar">@initial</span>
                                    <div>
                                        <span class="emp-name">@row.EmployeeName</span>
                                        <span class="emp-code">@row.EmployeeCode</span>
                                    </div>
                                </div>
                            </td>
                            <td>@row.DepartmentName</td>
                            <td>@row.ShiftName</td>
                            <td><span class="badge-count badge-green">@row.PresentDays</span></td>
                            <td><span class="badge-count badge-red">@row.AbsentDays</span></td>
                            <td><span class="badge-count badge-blue">@row.LeaveDays</span></td>
                            <td><span class="badge-count badge-amber">@row.HalfDays</span></td>
                            <td><span class="badge-count badge-purple">@row.LateCount</span></td>
                            <td>@row.TotalWorkedHours.ToString("0.0")</td>
                            <td class="text-ot">@row.TotalOvertimeHours.ToString("0.0")</td>
                            <td class="text-less">@row.TotalLessHours.ToString("0.0")</td>
                            <td>
                                <div class="pct-bar">
                                    <div class="pct-track">
                                        <div class="pct-fill @pctClass" style="width: @row.AttendancePercentage%;"></div>
                                    </div>
                                    <span class="pct-text">@row.AttendancePercentage%</span>
                                </div>
                            </td>
                        </tr>
                        rowNo++;
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="text-align:center; padding:60px 20px; color:var(--text-muted);">
            <i class="fas fa-calendar-times" style="font-size:48px; opacity:0.5; display:block; margin-bottom:16px;"></i>
            <h3>No Records</h3>
            <p>Selected month mein koi attendance nahi hai.</p>
        </div>
    }
</div>

<!-- ============================================= -->
