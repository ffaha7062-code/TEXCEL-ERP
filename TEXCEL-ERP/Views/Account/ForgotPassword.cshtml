@model TEXCEL_ERP.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewBag.Title = "Forgot Password";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="auth-card">
    <div class="auth-brand">
        <div class="logo-icon"><i class="fas fa-key"></i></div>
        <h1>TEXCEL <span>ERP</span></h1>
        <span class="tagline">Password Recovery</span>
    </div>

    <p style="text-align:center; font-size:13px; opacity:0.85; margin-bottom:20px;">
        Enter your email address and we'll send you a link to reset your password.
    </p>

    @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i>
                <div>@Html.ValidationSummary(true, "")</div>
            </div>
        }

        <div class="form-group">
            <label for="Email"><i class="fas fa-envelope"></i> Email Address</label>
            <div class="input-wrapper">
                @Html.TextBoxFor(m => m.Email, new { @placeholder = "your@email.com", @type = "email", @autofocus = "autofocus" })
                <i class="fas fa-envelope input-icon"></i>
            </div>
            @Html.ValidationMessageFor(m => m.Email)
        </div>

        <button type="submit" class="btn-gold">
            <i class="fas fa-paper-plane"></i>
            <span>Send Reset Link</span>
        </button>
    }

    <div class="auth-footer">
        Remember your password? <a href="@Url.Action("Login", "Account")">Sign In</a>
    </div>
</div>