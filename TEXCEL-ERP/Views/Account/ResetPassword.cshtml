@model TEXCEL_ERP.Models.ViewModels.ResetPasswordViewModel
@{
    ViewBag.Title = "Reset Password";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="auth-card">
    <div class="auth-brand">
        <div class="logo-icon"><i class="fas fa-lock-open"></i></div>
        <h1>TEXCEL <span>ERP</span></h1>
        <span class="tagline">Set New Password</span>
    </div>

    @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Code)

        if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i>
                <div>@Html.ValidationSummary(true, "")</div>
            </div>
        }

        <div class="form-group">
            <label for="Email"><i class="fas fa-envelope"></i> Email</label>
            <div class="input-wrapper">
                @Html.TextBoxFor(m => m.Email, new { @placeholder = "your@email.com", @type = "email" })
                <i class="fas fa-envelope input-icon"></i>
            </div>
            @Html.ValidationMessageFor(m => m.Email)
        </div>

        <div class="form-group">
            <label for="Password"><i class="fas fa-lock"></i> New Password</label>
            <div class="input-wrapper">
                @Html.PasswordFor(m => m.Password, new { @placeholder = "Min 6 characters", @id = "newPassword" })
                <i class="fas fa-lock input-icon"></i>
                <button type="button" class="toggle-password" data-target="newPassword">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            @Html.ValidationMessageFor(m => m.Password)
        </div>

        <div class="form-group">
            <label for="ConfirmPassword"><i class="fas fa-lock"></i> Confirm Password</label>
            <div class="input-wrapper">
                @Html.PasswordFor(m => m.ConfirmPassword, new { @placeholder = "Confirm password", @id = "newConfirmPassword" })
                <i class="fas fa-lock input-icon"></i>
                <button type="button" class="toggle-password" data-target="newConfirmPassword">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            @Html.ValidationMessageFor(m => m.ConfirmPassword)
        </div>

        <button type="submit" class="btn-gold">
            <i class="fas fa-save"></i>
            <span>Reset Password</span>
        </button>
    }
</div>