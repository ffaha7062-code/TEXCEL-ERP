@model TEXCEL_ERP.Models.ViewModels.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width:500px; margin:0 auto;">
    <h2 style="font-family:'Space Grotesk',sans-serif; font-size:24px; font-weight:700; margin-bottom:20px;">
        <i class="fas fa-key" style="color:#6c3cb0;"></i> Change Password
    </h2>

    <div style="background:white; padding:28px; border-radius:16px; box-shadow:0 2px 16px rgba(0,0,0,0.06);">

        @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            if (ViewBag.StatusMessage != null)
            {
                <div style="background:#d1fae5; color:#065f46; padding:12px; border-radius:10px; margin-bottom:16px; font-size:14px;">
                    <i class="fas fa-check-circle"></i> @ViewBag.StatusMessage
                </div>
            }

            if (!ViewData.ModelState.IsValid)
            {
                <div style="background:#fee2e2; color:#991b1b; padding:12px; border-radius:10px; margin-bottom:16px; font-size:14px;">
                    @Html.ValidationSummary(true, "")
                </div>
            }

            <div class="form-group" style="margin-bottom:16px;">
                <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px; color:#374151;">Current Password</label>
                @Html.PasswordFor(m => m.OldPassword, new { @style = "width:100%; padding:12px; border:1px solid #e5e7eb; border-radius:10px; font-size:14px;", @placeholder = "Enter current password" })
                @Html.ValidationMessageFor(m => m.OldPassword, "", new { @style = "color:#ef4444; font-size:12px;" })
            </div>

            <div class="form-group" style="margin-bottom:16px;">
                <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px; color:#374151;">New Password</label>
                @Html.PasswordFor(m => m.NewPassword, new { @style = "width:100%; padding:12px; border:1px solid #e5e7eb; border-radius:10px; font-size:14px;", @placeholder = "Min 6 characters" })
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @style = "color:#ef4444; font-size:12px;" })
            </div>

            <div class="form-group" style="margin-bottom:20px;">
                <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px; color:#374151;">Confirm New Password</label>
                @Html.PasswordFor(m => m.ConfirmPassword, new { @style = "width:100%; padding:12px; border:1px solid #e5e7eb; border-radius:10px; font-size:14px;", @placeholder = "Confirm new password" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @style = "color:#ef4444; font-size:12px;" })
            </div>

            <button type="submit" style="width:100%; padding:14px; background:linear-gradient(135deg,#6c3cb0,#8b5cf6); color:white; border:none; border-radius:10px; font-size:15px; font-weight:600; cursor:pointer;">
                <i class="fas fa-save"></i> Update Password
            </button>
        }
    </div>
</div>