@{
    ViewBag.Title = "Forgot Password Confirmation";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="auth-card">
    <div class="auth-brand">
        <div class="logo-icon" style="background: linear-gradient(135deg, #10b981, #34d399);">
            <i class="fas fa-check-circle"></i>
        </div>
        <h1>TEXCEL <span>ERP</span></h1>
        <span class="tagline">Email Sent</span>
    </div>

    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i>
        <div>Please check your email to reset your password.</div>
    </div>

    <div class="auth-footer">
        <a href="@Url.Action("Login", "Account")">Back to Login</a>
    </div>
</div>