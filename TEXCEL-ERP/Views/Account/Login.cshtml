@model TEXCEL_ERP.Models.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="auth-card">
    <div class="auth-brand">
        <div class="logo-icon"><i class="fas fa-tshirt"></i></div>
        <h1>TEXCEL <span>ERP</span></h1>
        <span class="tagline">Textile &amp; Garment ERP</span>
    </div>

    @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @id = "loginForm" }))
    {
        @Html.AntiForgeryToken()

        if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i>
                <div>@Html.ValidationSummary(true, "")</div>
            </div>
        }

        <div class="form-group">
            <label for="Email"><i class="fas fa-envelope"></i> Email Address</label>
            <div class="input-wrapper">
                @Html.TextBoxFor(m => m.Email, new { @placeholder = "admin@texcel.com", @type = "email", @autofocus = "autofocus" })
                <i class="fas fa-envelope input-icon"></i>
            </div>
            @Html.ValidationMessageFor(m => m.Email)
        </div>

        <div class="form-group">
            <label for="Password"><i class="fas fa-lock"></i> Password</label>
            <div class="input-wrapper">
                @Html.PasswordFor(m => m.Password, new { @placeholder = "Enter your password", @id = "passwordInput" })
                <i class="fas fa-lock input-icon"></i>
                <button type="button" class="toggle-password" id="togglePassword">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            @Html.ValidationMessageFor(m => m.Password)
        </div>

        <div class="form-options">
            <label>
                @Html.CheckBoxFor(m => m.RememberMe) Remember me
            </label>
            <a href="@Url.Action("ForgotPassword", "Account")">Forgot password?</a>
        </div>

        <button type="submit" class="btn-gold" id="loginBtn">
            <i class="fas fa-arrow-right-to-bracket"></i>
            <span>Sign In</span>
        </button>
    }

    <div class="auth-footer">
        Don't have an account? <a href="@Url.Action("Register", "Account")">Create Account</a>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/account.js"></script>
}