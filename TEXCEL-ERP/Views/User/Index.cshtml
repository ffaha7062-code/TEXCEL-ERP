@model List<TEXCEL_ERP.Models.ViewModels.UserViewModel>
@{
    ViewBag.Title = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var branches = ViewBag.Branches as List<TEXCEL_ERP.Models.Entities.Branch>;
    var roles = ViewBag.Roles as List<string>;
}

@section styles {
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
        }

            .page-header h1 {
                font-size: 28px;
                font-weight: 800;
                font-family: 'Space Grotesk', sans-serif;
                margin: 0;
                color: var(--text-primary);
            }

                .page-header h1 i {
                    color: var(--gold);
                    margin-right: 10px;
                }

        .btn-add {
            padding: 12px 24px;
            border-radius: 12px;
            background: linear-gradient(135deg, #6c3cb0, #8b5cf6);
            color: white;
            border: none;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 6px 20px rgba(108, 60, 176, 0.30);
            transition: all 0.3s;
            font-family: 'Inter', sans-serif;
        }

            .btn-add:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 30px rgba(108, 60, 176, 0.45);
            }

        /* ============================================= */
/* USER FILTER CARD — Distinct Design             */
/* ============================================= */
.user-filter-card {
    background: var(--bg-card);
    border-radius: 16px;
    padding: 24px 28px;
    border: 1px solid var(--border-color);
    margin-bottom: 24px;
    display: grid;
    grid-template-columns: 1fr 220px auto;
    gap: 20px;
    align-items: end;
    box-shadow: 0 4px 20px rgba(108, 60, 176, 0.05);
}

.user-filter-card form {
    display: contents;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.filter-group label {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    display: flex;
    align-items: center;
    gap: 6px;
}

.filter-group label i {
    color: var(--primary-light);
    font-size: 12px;
}

.filter-group input[type="text"],
.filter-group select {
    padding: 12px 16px;
    border-radius: 10px;
    border: 1.5px solid var(--border-color);
    background: var(--bg-body);
    color: var(--text-primary);
    font-size: 13px;
    outline: none;
    font-family: 'Inter', sans-serif;
    transition: all 0.3s;
    width: 100%;
}

.filter-group input[type="text"]:focus,
.filter-group select:focus {
    border-color: var(--primary-light);
    box-shadow: 0 0 0 4px rgba(108, 60, 176, 0.08);
    background: var(--bg-card);
}

.filter-actions {
    flex-direction: row;
    gap: 10px;
}

.btn-filter-primary {
    padding: 12px 24px;
    border-radius: 10px;
    background: linear-gradient(135deg, #6c3cb0, #8b5cf6);
    color: white;
    border: none;
    cursor: pointer;
    font-weight: 600;
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
    transition: all 0.3s;
    box-shadow: 0 4px 16px rgba(108, 60, 176, 0.25);
    white-space: nowrap;
}

.btn-filter-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(108, 60, 176, 0.40);
}

.btn-filter-reset {
    padding: 12px 20px;
    border-radius: 10px;
    background: transparent;
    color: var(--text-secondary);
    border: 1.5px solid var(--border-color);
    cursor: pointer;
    font-weight: 600;
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Inter', sans-serif;
    transition: all 0.3s;
    text-decoration: none;
    white-space: nowrap;
}

.btn-filter-reset:hover {
    background: var(--bg-body);
    border-color: var(--primary-light);
    color: var(--primary-light);
    text-decoration: none;
}

/* Responsive */
@@media (max-width: 900px) {
    .user-filter-card {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .filter-actions {
        flex-direction: column;
    }

    .btn-filter-primary,
    .btn-filter-reset {
        width: 100%;
        justify-content: center;
    }
}
        /* ============================================= */
        /* TABLE CARD                                     */
        /* ============================================= */
        .table-card {
            background: var(--bg-card);
            border-radius: 16px;
            border: 1px solid var(--border-color);
            overflow: hidden;
        }

            .table-card table {
                width: 100%;
                border-collapse: collapse;
            }

            .table-card thead {
                background: rgba(108, 60, 176, 0.05);
            }

            .table-card th {
                padding: 14px 18px;
                text-align: left;
                font-size: 11px;
                font-weight: 700;
                color: var(--text-secondary);
                text-transform: uppercase;
                border-bottom: 1px solid var(--border-color);
            }

            .table-card td {
                padding: 14px 18px;
                font-size: 13px;
                color: var(--text-primary);
                border-bottom: 1px solid var(--border-color);
            }

            .table-card tr:last-child td {
                border-bottom: none;
            }

            .table-card tbody tr:hover {
                background: rgba(108, 60, 176, 0.03);
            }

        .user-avatar-sm {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, #6c3cb0, #8b5cf6);
            color: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 13px;
            margin-right: 10px;
        }

        .role-badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            background: rgba(108, 60, 176, 0.12);
            color: #8b5cf6;
        }

        .badge-active {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            background: rgba(16, 185, 129, 0.12);
            color: #10b981;
        }

        .badge-inactive {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            background: rgba(239, 68, 68, 0.10);
            color: #ef4444;
        }

        .action-btn {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: var(--bg-body);
            color: var(--text-secondary);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 4px;
            font-size: 13px;
        }

            .action-btn:hover {
                background: rgba(108, 60, 176, 0.10);
                color: #8b5cf6;
                border-color: #8b5cf6;
            }

            .action-btn.delete:hover {
                background: rgba(239, 68, 68, 0.10);
                color: #ef4444;
                border-color: #ef4444;
            }

        /* ============================================= */
        /* MODAL                                          */
        /* ============================================= */
        .modal-bg {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(10, 10, 20, 0.75);
            z-index: 2147483647;
            padding: 90px 16px 20px 16px;
            overflow-y: auto;
            align-items: flex-start;
            justify-content: center;
        }

            .modal-bg.show {
                display: flex !important;
            }

        .modal-box {
            background: #ffffff;
            border-radius: 14px;
            width: 100%;
            max-width: 620px;
            max-height: calc(100vh - 180px);
            display: flex;
            flex-direction: column;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.40);
            overflow: hidden;
        }

        [data-theme="dark"] .modal-box {
            background: #1a1a2e;
        }

        .modal-top {
            background: linear-gradient(135deg, #6c3cb0, #8b5cf6);
            padding: 14px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
            flex-shrink: 0;
        }

            .modal-top h3 {
                margin: 0;
                font-size: 15px;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .modal-top h3 i {
                    color: #fbbf24;
                }

            .modal-top button {
                background: rgba(255, 255, 255, 0.2);
                border: none;
                color: white;
                width: 28px;
                height: 28px;
                border-radius: 7px;
                cursor: pointer;
                font-size: 12px;
                flex-shrink: 0;
            }

                .modal-top button:hover {
                    background: rgba(255, 255, 255, 0.35);
                }

        .modal-form {
            padding: 16px 20px;
            overflow-y: auto;
            flex: 1 1 auto;
            min-height: 0;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 10px;
        }

            .form-row.full {
                grid-template-columns: 1fr;
            }

            .form-row label {
                display: block;
                font-size: 10px;
                font-weight: 700;
                color: var(--text-secondary);
                margin-bottom: 4px;
                text-transform: uppercase;
                letter-spacing: 0.3px;
            }

            .form-row input,
            .form-row select {
                width: 100%;
                padding: 8px 11px;
                border-radius: 8px;
                border: 1.5px solid var(--border-color);
                background: var(--bg-body);
                color: var(--text-primary);
                font-size: 13px;
                outline: none;
                font-family: 'Inter', sans-serif;
            }

                .form-row input:focus,
                .form-row select:focus {
                    border-color: #8b5cf6;
                    box-shadow: 0 0 0 2px rgba(108, 60, 176, 0.10);
                }

        .modal-actions {
            padding: 12px 20px;
            background: rgba(240, 242, 245, 0.7);
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            border-top: 1px solid var(--border-color);
            flex-shrink: 0;
        }

        [data-theme="dark"] .modal-actions {
            background: rgba(10, 10, 20, 0.6);
        }

        .btn-cancel {
            padding: 8px 18px;
            border-radius: 8px;
            background: transparent;
            border: 1.5px solid var(--border-color);
            color: var(--text-secondary);
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
        }

        .btn-save {
            padding: 8px 18px;
            border-radius: 8px;
            background: linear-gradient(135deg, #6c3cb0, #8b5cf6);
            color: white;
            border: none;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-save:hover {
                box-shadow: 0 6px 20px rgba(108, 60, 176, 0.45);
            }

        @@media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }

            .modal-box {
                max-width: 100%;
            }

            .filter-card input[type="text"],
            .filter-card select {
                width: 100% !important;
            }
        }
    </style>
}

<div class="page-header">
    <h1><i class="fas fa-users"></i> Users</h1>
    <button type="button" class="btn-add" id="openModalBtn">
        <i class="fas fa-plus"></i> Add New User
    </button>
</div>

<!-- User Filter Card — Distinct Design -->
<div class="user-filter-card">
    @using (Html.BeginForm("Index", "User", FormMethod.Get))
    {
        <div class="filter-group">
            <label><i class="fas fa-search"></i> Search User</label>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Type name, email or phone..." />
        </div>

        <div class="filter-group">
            <label><i class="fas fa-toggle-on"></i> Status</label>
            <select name="isActive">
                <option value="">All Users</option>
                <option value="true" @(ViewBag.IsActive == true ? "selected" : "")>Active Only</option>
                <option value="false" @(ViewBag.IsActive == false ? "selected" : "")>Inactive Only</option>
            </select>
        </div>

        <div class="filter-group filter-actions">
            <button type="submit" class="btn-filter-primary">
                <i class="fas fa-filter"></i> Apply Filter
            </button>
            <a href="@Url.Action("Index", "User")" class="btn-filter-reset">
                <i class="fas fa-redo"></i> Reset
            </a>
        </div>
    }
</div>
<div class="table-card">
    @if (Model != null && Model.Any())
    {
        <table>
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>
                            <span class="user-avatar-sm">
                                @(u.FirstName != null ? u.FirstName.Substring(0, 1).ToUpper() : "U")
                            </span>
                            <strong>@u.FirstName @u.LastName</strong>
                        </td>
                        <td>@u.Email</td>
                        <td>@(u.PhoneNumber ?? "-")</td>
                        <td><span class="role-badge">@u.RoleName</span></td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge-active">Active</span>
                            }
                            else
                            {
                                <span class="badge-inactive">Inactive</span>
                            }
                        </td>
                        <td style="text-align:right;">
                            <button type="button" class="action-btn toggle-btn" data-id="@u.Id">
                                <i class="fas fa-power-off"></i>
                            </button>
                            <button type="button" class="action-btn delete delete-btn" data-id="@u.Id">
                                <i class="fas fa-user-slash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="text-align:center; padding:60px 20px; color:var(--text-muted);">
            <i class="fas fa-users" style="font-size:48px; opacity:0.5; display:block; margin-bottom:16px;"></i>
            <h3>No Users Found</h3>
            <p>Click "Add New User" to create one.</p>
        </div>
    }
</div>

<!-- MODAL -->
<div class="modal-bg" id="userModal">
    <div class="modal-box">
        <div class="modal-top">
            <h3><i class="fas fa-user-plus"></i> Add New User</h3>
            <button type="button" id="closeModalBtn">
                <i class="fas fa-times"></i>
            </button>
        </div>

        @using (Html.BeginForm("Create", "User", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="modal-form">
                <div class="form-row">
                    <div>
                        <label>First Name *</label>
                        <input type="text" name="FirstName" placeholder="First Name" required />
                    </div>
                    <div>
                        <label>Last Name</label>
                        <input type="text" name="LastName" placeholder="Last Name" />
                    </div>
                </div>

                <div class="form-row">
                    <div>
                        <label>Email *</label>
                        <input type="email" name="Email" placeholder="user@texcel.com" required />
                    </div>
                    <div>
                        <label>Phone</label>
                        <input type="text" name="PhoneNumber" placeholder="0300-1234567" />
                    </div>
                </div>

                <div class="form-row">
                    <div>
                        <label>Password *</label>
                        <input type="password" name="Password" placeholder="Min 6 characters" required minlength="6" />
                    </div>
                    <div>
                        <label>Role *</label>
                        <select name="RoleName" required>
                            <option value="">-- Select Role --</option>
                            @if (roles != null)
                            {
                                foreach (var r in roles)
                                {
                                    <option value="@r">@r</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="form-row full">
                    <div>
                        <label>Branch</label>
                        <select name="BranchId">
                            <option value="">-- Select Branch --</option>
                            @if (branches != null)
                            {
                                foreach (var b in branches)
                                {
                                    <option value="@b.BranchId">@b.BranchName</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" id="cancelBtn">Cancel</button>
                <button type="submit" class="btn-save"><i class="fas fa-save"></i> Create User</button>
            </div>
        }
    </div>
</div>

@section scripts {
    <script src="~/Scripts/user.js"></script>
}