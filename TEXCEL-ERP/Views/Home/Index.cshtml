@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 style="font-family:'Space Grotesk',sans-serif; font-size:28px; font-weight:800; margin-bottom:8px;">
    Welcome to TEXCEL ERP™
</h1>
<p style="color:#6b7280; margin-bottom:24px;">
    Project setup complete — Part 1 is running successfully!
</p>

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:20px;">
    <div style="background:white; padding:24px; border-radius:16px; box-shadow:0 2px 16px rgba(0,0,0,0.06);">
        <h3 style="color:#6b7280; font-size:13px; font-weight:500; margin-bottom:8px;">Total Employees</h3>
        <p style="font-size:28px; font-weight:800; color:#1a1a2e;">@Model.TotalEmployees</p>
    </div>
    <div style="background:white; padding:24px; border-radius:16px; box-shadow:0 2px 16px rgba(0,0,0,0.06);">
        <h3 style="color:#6b7280; font-size:13px; font-weight:500; margin-bottom:8px;">Present Today</h3>
        <p style="font-size:28px; font-weight:800; color:#1a1a2e;">@Model.PresentToday</p>
    </div>
    <div style="background:white; padding:24px; border-radius:16px; box-shadow:0 2px 16px rgba(0,0,0,0.06);">
        <h3 style="color:#6b7280; font-size:13px; font-weight:500; margin-bottom:8px;">Monthly Payroll</h3>
        <p style="font-size:28px; font-weight:800; color:#1a1a2e;">@Model.MonthlyPayroll.ToString("N0")</p>
    </div>
    <div style="background:white; padding:24px; border-radius:16px; box-shadow:0 2px 16px rgba(0,0,0,0.06);">
        <h3 style="color:#6b7280; font-size:13px; font-weight:500; margin-bottom:8px;">Monthly Sales</h3>
        <p style="font-size:28px; font-weight:800; color:#1a1a2e;">@Model.MonthlySales.ToString("N0")</p>
    </div>
</div>