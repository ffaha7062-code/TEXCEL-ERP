@model List<TEXCEL_ERP.Models.Entities.Branch>
@{
    ViewBag.Title = "Branches";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canModify = ViewBag.CanModify != null && (bool)ViewBag.CanModify;
    var canDelete = ViewBag.CanDelete != null && (bool)ViewBag.CanDelete;
}

@section styles {
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
        }

            .page-header h1 {
                font-size: 28px;
                font-weight: 800;
                font-family: 'Space Grotesk', sans-serif;
                margin: 0;
                color: var(--text-primary);
            }

                .page-header h1 i {
                    color: var(--gold);
                    margin-right: 10px;
                }

        .btn-add {
            padding: 12px 24px;
            border-radius: 12px;
            background: linear-gradient(135deg, #6c3cb0, #8b5cf6);
            color: white;
            border: none;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 6px 20px rgba(108, 60, 176, 0.30);
            transition: all 0.3s;
            font-family: 'Inter', sans-serif;
        }

            .btn-add:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 30px rgba(108, 60, 176, 0.45);
            }

        /* FILTER CARD */
        .branch-filter-card {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 24px 28px;
            border: 1px solid var(--border-color);
            margin-bottom: 24px;
            display: grid;
            grid-template-columns: 1fr 220px auto;
            gap: 20px;
            align-items: end;
            box-shadow: 0 4px 20px rgba(108, 60, 176, 0.05);
        }

            .branch-filter-card form {
                display: contents;
            }

            .branch-filter-card .filter-group {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

                .branch-filter-card .filter-group label {
                    font-size: 11px;
                    font-weight: 700;
                    color: var(--text-secondary);
                    text-transform: uppercase;
                    letter-spacing: 0.8px;
                    display: flex;
                    align-items: center;
                    gap: 6px;
                }

                    .branch-filter-card .filter-group label i {
                        color: var(--primary-light);
                        font-size: 12px;
                    }

                .branch-filter-card .filter-group input[type="text"],
                .branch-filter-card .filter-group select {
                    padding: 12px 16px;
                    border-radius: 10px;
                    border: 1.5px solid var(--border-color);
                    background: var(--bg-body);
                    color: var(--text-primary);
                    font-size: 13px;
                    outline: none;
                    font-family: 'Inter', sans-serif;
                    transition: all 0.3s;
                    width: 100%;
                }

                    .branch-filter-card .filter-group input[type="text"]:focus,
                    .branch-filter-card .filter-group select:focus {
                        border-color: var(--primary-light);
                        box-shadow: 0 0 0 4px rgba(108, 60, 176, 0.08);
                        background: var(--bg-card);
                    }

            .branch-filter-card .filter-actions {
                flex-direction: row;
                gap: 10px;
            }

            .branch-filter-card .btn-filter-primary {
                padding: 12px 24px;
                border-radius: 10px;
                background: linear-gradient(135deg, #6c3cb0, #8b5cf6);
                color: white;
                border: none;
                cursor: pointer;
                font-weight: 600;
                font-size: 13px;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-family: 'Inter', sans-serif;
                transition: all 0.3s;
                box-shadow: 0 4px 16px rgba(108, 60, 176, 0.25);
                white-space: nowrap;
            }

                .branch-filter-card .btn-filter-primary:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 24px rgba(108, 60, 176, 0.40);
                }

            .branch-filter-card .btn-filter-reset {
                padding: 12px 20px;
                border-radius: 10px;
                background: transparent;
                color: var(--text-secondary);
                border: 1.5px solid var(--border-color);
                cursor: pointer;
                font-weight: 600;
                font-size: 13px;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-family: 'Inter', sans-serif;
                transition: all 0.3s;
                text-decoration: none;
                white-space: nowrap;
            }

                .branch-filter-card .btn-filter-reset:hover {
                    background: var(--bg-body);
                    border-color: var(--primary-light);
                    color: var(--primary-light);
                    text-decoration: none;
                }

        @@media (max-width: 900px) {
            .branch-filter-card {
                grid-template-columns: 1fr;
                gap: 16px;
            }

                .branch-filter-card .filter-actions {
                    flex-direction: column;
                }

                .branch-filter-card .btn-filter-primary,
                .branch-filter-card .btn-filter-reset {
                    width: 100%;
                    justify-content: center;
                }
        }

        /* TABLE CARD */
        .table-card {
            background: var(--bg-card);
            border-radius: 16px;
            border: 1px solid var(--border-color);
            overflow: hidden;
        }

            .table-card table {
                width: 100%;
                border-collapse: collapse;
            }

            .table-card thead {
                background: rgba(108, 60, 176, 0.05);
            }

            .table-card th {
                padding: 14px 18px;
                text-align: left;
                font-size: 11px;
                font-weight: 700;
                color: var(--text-secondary);
                text-transform: uppercase;
                border-bottom: 1px solid var(--border-color);
            }

            .table-card td {
                padding: 14px 18px;
                font-size: 13px;
                color: var(--text-primary);
                border-bottom: 1px solid var(--border-color);
            }

            .table-card tr:last-child td {
                border-bottom: none;
            }

            .table-card tbody tr:hover {
                background: rgba(108, 60, 176, 0.03);
            }

        .badge-active {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            background: rgba(16, 185, 129, 0.12);
            color: #10b981;
        }

        .badge-inactive {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            background: rgba(239, 68, 68, 0.10);
            color: #ef4444;
        }

        .action-btn {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: var(--bg-body);
            color: var(--text-secondary);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 4px;
            font-size: 13px;
        }

            .action-btn:hover {
                background: rgba(108, 60, 176, 0.10);
                color: #8b5cf6;
                border-color: #8b5cf6;
            }

            .action-btn.delete-btn:hover {
                background: rgba(239, 68, 68, 0.10);
                color: #ef4444;
                border-color: #ef4444;
            }

        /* ============================================= */
        /* MODAL                                          */
        /* ============================================= */
        .modal-bg {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(10, 10, 20, 0.85);
            z-index: 99999;
            overflow-y: auto;
            padding: 100px 16px 100px 16px;
            box-sizing: border-box;
        }

            .modal-bg.show {
                display: flex;
                align-items: flex-start;
                justify-content: center;
            }

            .modal-bg.show {
                display: flex;
                align-items: center;
                justify-content: center;
            }

        .modal-box {
            background: #ffffff;
            border-radius: 14px;
            width: 100%;
            max-width: 580px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.40);
            overflow: hidden;
            margin: 0 auto;
        }

        [data-theme="dark"] .modal-box {
            background: #1a1a2e;
        }

        .modal-top {
            background: linear-gradient(135deg, #6c3cb0, #8b5cf6);
            padding: 14px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
            flex-shrink: 0;
        }

            .modal-top h3 {
                margin: 0;
                font-size: 15px;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .modal-top h3 i {
                    color: #fbbf24;
                }

            .modal-top button {
                background: rgba(255, 255, 255, 0.2);
                border: none;
                color: white;
                width: 28px;
                height: 28px;
                border-radius: 7px;
                cursor: pointer;
                font-size: 12px;
                flex-shrink: 0;
            }

        .modal-form {
            padding: 16px 20px;
            overflow-y: auto;
            flex: 1 1 auto;
            min-height: 0;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 10px;
        }

            .form-row.full {
                grid-template-columns: 1fr;
            }

            .form-row label {
                display: block;
                font-size: 10px;
                font-weight: 700;
                color: var(--text-secondary);
                margin-bottom: 4px;
                text-transform: uppercase;
                letter-spacing: 0.3px;
            }

            .form-row input,
            .form-row select,
            .form-row textarea {
                width: 100%;
                padding: 8px 11px;
                border-radius: 8px;
                border: 1.5px solid var(--border-color);
                background: var(--bg-body);
                color: var(--text-primary);
                font-size: 13px;
                outline: none;
                font-family: 'Inter', sans-serif;
            }

                .form-row input:focus,
                .form-row select:focus,
                .form-row textarea:focus {
                    border-color: #8b5cf6;
                    box-shadow: 0 0 0 2px rgba(108, 60, 176, 0.10);
                }

            .form-row textarea {
                resize: none;
                height: 50px;
            }

        .modal-actions {
            padding: 12px 20px;
            background: rgba(240, 242, 245, 0.7);
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            border-top: 1px solid var(--border-color);
            flex-shrink: 0;
        }

        [data-theme="dark"] .modal-actions {
            background: rgba(10, 10, 20, 0.6);
        }

        .btn-cancel {
            padding: 8px 18px;
            border-radius: 8px;
            background: transparent;
            border: 1.5px solid var(--border-color);
            color: var(--text-secondary);
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
        }

        .btn-save {
            padding: 8px 18px;
            border-radius: 8px;
            background: linear-gradient(135deg, #6c3cb0, #8b5cf6);
            color: white;
            border: none;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-save:hover {
                box-shadow: 0 6px 20px rgba(108, 60, 176, 0.45);
            }

        /* TOAST */
        #toastContainer {
            position: fixed;
            top: 90px;
            right: 20px;
            z-index: 999999;
            display: flex;
            flex-direction: column;
            gap: 10px;
            pointer-events: none;
        }

        .toast {
            padding: 14px 20px;
            border-radius: 10px;
            background: #ffffff;
            color: #333;
            font-size: 14px;
            font-weight: 600;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.20);
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 260px;
            max-width: 380px;
            animation: toastIn 0.3s ease;
            pointer-events: auto;
        }

        [data-theme="dark"] .toast {
            background: #1a1a2e;
            color: #fff;
        }

        .toast-success {
            border-left: 4px solid #10b981;
        }

            .toast-success i {
                color: #10b981;
            }

        .toast-error {
            border-left: 4px solid #ef4444;
        }

            .toast-error i {
                color: #ef4444;
            }

        .toast-info {
            border-left: 4px solid #8b5cf6;
        }

            .toast-info i {
                color: #8b5cf6;
            }

        .toast-hide {
            animation: toastOut 0.3s ease forwards;
        }

        @@keyframes toastIn {
            from {
                opacity: 0;
                transform: translateX(40px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@keyframes toastOut {
            from {
                opacity: 1;
                transform: translateX(0);
            }

            to {
                opacity: 0;
                transform: translateX(40px);
            }
        }

        @@media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }

            .modal-box {
                max-width: 100%;
            }
        }
    </style>
}

<!-- TOAST CONTAINER -->
<div id="toastContainer"></div>

<div class="page-header">
    <h1><i class="fas fa-building"></i> Branches</h1>
    @if (canModify)
    {
        <button type="button" class="btn-add" id="openModalBtn">
            <i class="fas fa-plus"></i> Add New Branch
        </button>
    }
</div>

<div class="branch-filter-card">
    @using (Html.BeginForm("Index", "Branch", FormMethod.Get))
    {
        <div class="filter-group">
            <label><i class="fas fa-search"></i> Search Branch</label>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Type name, code or city..." />
        </div>

        <div class="filter-group">
            <label><i class="fas fa-toggle-on"></i> Status</label>
            <select name="isActive">
                <option value="">All Branches</option>
                <option value="true" @(ViewBag.IsActive == true ? "selected" : "")>Active Only</option>
                <option value="false" @(ViewBag.IsActive == false ? "selected" : "")>Inactive Only</option>
            </select>
        </div>

        <div class="filter-group filter-actions">
            <button type="submit" class="btn-filter-primary">
                <i class="fas fa-filter"></i> Apply Filter
            </button>
            <a href="@Url.Action("Index", "Branch")" class="btn-filter-reset">
                <i class="fas fa-redo"></i> Reset
            </a>
        </div>
    }
</div>

<div class="table-card">
    @if (Model != null && Model.Any())
    {
        <table>
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Branch Name</th>
                    <th>City</th>
                    <th>Phone</th>
                    <th>Manager</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td><strong>@b.BranchCode</strong></td>
                        <td>@b.BranchName</td>
                        <td>@(b.City ?? "-")</td>
                        <td>@(b.Phone ?? "-")</td>
                        <td>@(b.ManagerName ?? "-")</td>
                        <td>
                            @if (b.IsActive)
                            {
                                <span class="badge-active">Active</span>
                            }
                            else
                            {
                                <span class="badge-inactive">Inactive</span>
                            }
                        </td>
                        <td style="text-align:right;">
                            @if (canModify)
                            {
                                <button type="button" class="action-btn edit-btn" data-id="@b.BranchId" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button" class="action-btn toggle-btn" data-id="@b.BranchId" title="Toggle Status">
                                    <i class="fas fa-power-off"></i>
                                </button>
                            }
                            @if (canDelete)
                            {
                                <button type="button" class="action-btn delete-btn" data-id="@b.BranchId" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="text-align:center; padding:60px 20px; color:var(--text-muted);">
            <i class="fas fa-building" style="font-size:48px; opacity:0.5; display:block; margin-bottom:16px;"></i>
            <h3>No Branches Found</h3>
            <p>Click "Add New Branch" to create one.</p>
        </div>
    }
</div>

<!-- MODAL (Create + Edit) -->
<div class="modal-bg" id="branchModal">
    <div class="modal-box">
        <div class="modal-top">
            <h3 id="modalTitle"><i class="fas fa-plus-circle"></i> Add New Branch</h3>
            <button type="button" id="closeModalBtn"><i class="fas fa-times"></i></button>
        </div>

        <form id="branchForm" action="/Branch/Create" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="BranchId" value="0" />

            <div class="modal-form">
                <div class="form-row full">
                    <div>
                        <label>Company *</label>
                        <select name="CompanyId" required>
                            <option value="">-- Select Company --</option>
                            @{
                                var ctx = new TEXCEL_ERP.Data.ApplicationDbContext();
                                var comp = ctx.Companies.FirstOrDefault();
                                if (comp != null)
                                {
                                    <option value="@comp.CompanyId">@comp.CompanyName</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div>
                        <label>Branch Code *</label>
                        <input type="text" name="BranchCode" placeholder="LHR-01" required maxlength="20" />
                    </div>
                    <div>
                        <label>Branch Name *</label>
                        <input type="text" name="BranchName" placeholder="Lahore Branch" required maxlength="200" />
                    </div>
                </div>

                <div class="form-row">
                    <div>
                        <label>City</label>
                        <input type="text" name="City" maxlength="100" />
                    </div>
                    <div>
                        <label>Phone</label>
                        <input type="text" name="Phone" maxlength="20" />
                    </div>
                </div>

                <div class="form-row">
                    <div>
                        <label>Email</label>
                        <input type="email" name="Email" maxlength="100" />
                    </div>
                    <div>
                        <label>Manager Name</label>
                        <input type="text" name="ManagerName" maxlength="100" />
                    </div>
                </div>

                <div class="form-row full">
                    <div>
                        <label>Address</label>
                        <textarea name="Address" rows="2" maxlength="500"></textarea>
                    </div>
                </div>

                <div class="form-row full">
                    <div>
                        <label style="display:flex; align-items:center; gap:8px; text-transform:none; letter-spacing:0;">
                            <input type="checkbox" name="IsActive" value="true" checked style="width:auto;" />
                            <span>Mark as Active</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" id="cancelBtn">Cancel</button>
                <button type="submit" class="btn-save"><i class="fas fa-save"></i> Save Branch</button>
            </div>
  rn       </form>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/branch.js"></script>
}