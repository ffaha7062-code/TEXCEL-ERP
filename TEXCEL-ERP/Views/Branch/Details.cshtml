@model TEXCEL_ERP.Models.Entities.Branch
@{
    ViewBag.Title = "Branch Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <style>
        .details-container { max-width: 900px; margin: 0 auto; }
        .details-card {
            background: var(--bg-card);
            backdrop-filter: blur(16px);
            border-radius: 20px;
            padding: 32px;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow);
        }
        .details-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 24px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
        }
        .branch-icon {
            width: 72px;
            height: 72px;
            border-radius: 16px;
            background: var(--primary-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 32px;
            box-shadow: 0 8px 24px rgba(108, 60, 176, 0.30);
        }
        .branch-title h2 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 26px;
            font-weight: 800;
            margin: 0;
            color: var(--text-primary);
        }
        .branch-title p { color: var(--text-muted); margin: 4px 0 0 0; font-size: 14px; }

        .details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        .detail-item {
            padding: 14px 0;
            border-bottom: 1px solid var(--border-color);
        }
        .detail-item label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }
        .detail-item span {
            font-size: 15px;
            color: var(--text-primary);
            font-weight: 500;
        }

        .details-actions {
            display: flex;
            gap: 12px;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid var(--border-color);
        }
        .btn-secondary-custom {
            padding: 12px 24px;
            border-radius: 12px;
            background: var(--bg-body);
            color: var(--text-primary);
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            border: 1px solid var(--border-color);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s;
        }
        .btn-secondary-custom:hover {
            background: var(--border-color);
            color: var(--text-primary);
        }

        @@media (max-width: 600px) {
            .details-grid { grid-template-columns: 1fr; }
            .details-header { flex-direction: column; text-align: center; }
            .details-card { padding: 20px; }
        }
    </style>
}

<div class="details-container">
    <div class="details-card">
        <div class="details-header">
            <div class="branch-icon"><i class="fas fa-building"></i></div>
            <div class="branch-title">
                <h2>@Model.BranchName</h2>
                <p>Branch Code: <strong>@Model.BranchCode</strong></p>
            </div>
        </div>

        <div class="details-grid">
            <div class="detail-item">
                <label>Branch Code</label>
                <span>@Model.BranchCode</span>
            </div>
            <div class="detail-item">
                <label>Branch Name</label>
                <span>@Model.BranchName</span>
            </div>
            <div class="detail-item">
                <label>City</label>
                <span>@(Model.City ?? "-")</span>
            </div>
            <div class="detail-item">
                <label>Phone</label>
                <span>@(Model.Phone ?? "-")</span>
            </div>
            <div class="detail-item">
                <label>Email</label>
                <span>@(Model.Email ?? "-")</span>
            </div>
            <div class="detail-item">
                <label>Manager</label>
                <span>@(Model.ManagerName ?? "-")</span>
            </div>
            <div class="detail-item" style="grid-column: 1 / -1;">
                <label>Address</label>
                <span>@(Model.Address ?? "-")</span>
            </div>
            <div class="detail-item">
                <label>Status</label>
                <span>
                    @if (Model.IsActive)
                    {
                        <span style="padding:4px 12px; border-radius:20px; background:rgba(16,185,129,0.12); color:#10b981; font-size:12px; font-weight:700;">Active</span>
                    }
                    else
                    {
                        <span style="padding:4px 12px; border-radius:20px; background:rgba(239,68,68,0.10); color:#ef4444; font-size:12px; font-weight:700;">Inactive</span>
                    }
                </span>
            </div>
            <div class="detail-item">
                <label>Created Date</label>
                <span>@Model.CreatedDate.ToString("dd MMM yyyy")</span>
            </div>
        </div>

        <div class="details-actions">
            <a href="@Url.Action("Edit", "Branch", new { id = Model.BranchId })" class="btn-primary-custom">
                <i class="fas fa-edit"></i> Edit Branch
            </a>
            <a href="@Url.Action("Index", "Branch")" class="btn-secondary-custom">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>