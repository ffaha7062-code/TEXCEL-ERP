@model List<TEXCEL_ERP.Models.ViewModels.EmployeeAttendanceRow>
@using TEXCEL_ERP.Models.Enums
@{
    ViewBag.Title = "Bulk Attendance Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var branches = ViewBag.Branches as List<TEXCEL_ERP.Models.Entities.Branch>;
    var shifts = ViewBag.Shifts as List<TEXCEL_ERP.Models.Entities.Shift>;
    var attendanceDate = (DateTime)ViewBag.AttendanceDate;
    var selectedBranchId = ViewBag.SelectedBranchId as int?;
    var selectedShiftId = ViewBag.SelectedShiftId as int?;
    var canModify = ViewBag.CanModify != null && (bool)ViewBag.CanModify;
    var canDelete = ViewBag.CanDelete != null && (bool)ViewBag.CanDelete;
}

@section styles {
    <style>
        /* Back Button */
        .page-back-btn {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.20);
            backdrop-filter: blur(10px);
            border: 1.5px solid rgba(255, 255, 255, 0.35);
            color: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 16px;
            transition: all 0.3s;
            flex-shrink: 0;
        }

            .page-back-btn:hover {
                background: rgba(255, 255, 255, 0.35);
                border-color: rgba(255, 255, 255, 0.60);
                color: white;
                text-decoration: none;
                transform: translateX(-4px);
            }
        /* ============================================= */
        /* PAGE THEME — PURPLE (BULK)                    */
        /* ============================================= */
        .page-header-bulk {
            background: linear-gradient(135deg, #6c3cb0, #8b5cf6);
            border-radius: 20px;
            padding: 28px 32px;
            margin-bottom: 24px;
            color: white;
            box-shadow: 0 12px 32px rgba(108, 60, 176, 0.35);
            display: flex;
            align-items: center;
            gap: 20px;
        }

            .page-header-bulk .header-icon {
                width: 64px;
                height: 64px;
                border-radius: 16px;
                background: rgba(255, 255, 255, 0.20);
                backdrop-filter: blur(10px);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 28px;
                color: white;
                flex-shrink: 0;
            }

            .page-header-bulk h1 {
                font-size: 26px;
                font-weight: 800;
                font-family: 'Space Grotesk', sans-serif;
                margin: 0 0 4px 0;
                color: white;
            }

            .page-header-bulk p {
                font-size: 13px;
                margin: 0;
                color: rgba(255, 255, 255, 0.85);
            }
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
        }

            .page-header h1 {
                font-size: 28px;
                font-weight: 800;
                font-family: 'Space Grotesk', sans-serif;
                margin: 0;
                color: var(--text-primary);
            }

                .page-header h1 i {
                    color: var(--gold);
                    margin-right: 10px;
                }

        /* Filter Card */
        .filter-card {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 20px 24px;
            border: 1px solid var(--border-color);
            margin-bottom: 20px;
            box-shadow: 0 4px 20px rgba(108, 60, 176, 0.05);
        }

        .filter-row {
            display: grid;
            grid-template-columns: 220px 220px 220px auto;
            gap: 14px;
            align-items: end;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

            .filter-group label {
                font-size: 10px;
                font-weight: 700;
                color: var(--text-secondary);
                text-transform: uppercase;
                letter-spacing: 0.6px;
            }

            .filter-group input, .filter-group select {
                padding: 10px 12px;
                border-radius: 10px;
                border: 1.5px solid var(--border-color);
                background: var(--bg-body);
                color: var(--text-primary);
                font-size: 13px;
                outline: none;
                font-family: 'Inter', sans-serif;
                width: 100%;
            }

        .filter-actions {
            display: flex;
            gap: 8px;
            align-items: end;
        }

        .btn-filter-primary {
            padding: 10px 18px;
            border-radius: 10px;
            background: linear-gradient(135deg, #6c3cb0, #8b5cf6);
            color: white;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-size: 13px;
            white-space: nowrap;
            font-family: 'Inter', sans-serif;
        }

        .btn-filter-reset {
            padding: 10px 16px;
            border-radius: 10px;
            background: transparent;
            color: var(--text-secondary);
            border: 1.5px solid var(--border-color);
            font-weight: 600;
            font-size: 13px;
            text-decoration: none;
            white-space: nowrap;
            font-family: 'Inter', sans-serif;
        }

        /* Shift Info Banner */
        .shift-info {
            background: linear-gradient(135deg, rgba(108, 60, 176, 0.08), rgba(139, 92, 246, 0.08));
            border: 1.5px solid rgba(108, 60, 176, 0.20);
            border-radius: 12px;
            padding: 14px 20px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }

            .shift-info .info-text {
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 14px;
                font-weight: 600;
                color: var(--primary-light);
            }

                .shift-info .info-text i {
                    font-size: 20px;
                    color: var(--gold);
                }

        /* Attendance Table */
        .attendance-table-card {
            background: var(--bg-card);
            border-radius: 16px;
            border: 1px solid var(--border-color);
            overflow: hidden;
            overflow-x: auto;
        }

        table.att-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1200px;
        }

        .att-table thead {
            background: linear-gradient(135deg, rgba(108, 60, 176, 0.10), rgba(139, 92, 246, 0.10));
        }

        .att-table th {
            padding: 12px 10px;
            text-align: left;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid var(--border-color);
            white-space: nowrap;
        }

        .att-table td {
            padding: 10px;
            font-size: 13px;
            color: var(--text-primary);
            border-bottom: 1px solid var(--border-color);
            vertical-align: middle;
        }

        .att-table tbody tr:hover {
            background: rgba(108, 60, 176, 0.03);
        }

        .emp-name-cell {
            font-weight: 600;
        }

        .emp-code-cell {
            font-size: 11px;
            color: var(--text-muted);
        }

        .att-input {
            padding: 6px 8px;
            border-radius: 6px;
            border: 1.5px solid var(--border-color);
            background: var(--bg-body);
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            font-family: 'Inter', sans-serif;
            width: 100%;
            min-width: 90px;
        }

            .att-input:focus {
                border-color: var(--primary-light);
                box-shadow: 0 0 0 2px rgba(108, 60, 176, 0.10);
            }

        .att-select {
            padding: 6px 8px;
            border-radius: 6px;
            border: 1.5px solid var(--border-color);
            background: var(--bg-body);
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            font-family: 'Inter', sans-serif;
            min-width: 100px;
        }

        .calc-cell {
            font-weight: 700;
            font-size: 12px;
            text-align: center;
            color: var(--text-secondary);
        }

        .calc-ot {
            color: #10b981;
        }

        .calc-less {
            color: #ef4444;
        }

        .sign-check {
            width: 24px;
            height: 24px;
            cursor: pointer;
            accent-color: var(--primary-light);
        }

        .btn-save-all {
            padding: 12px 32px;
            border-radius: 12px;
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            border: none;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.30);
            transition: all 0.3s;
            font-family: 'Inter', sans-serif;
        }

            .btn-save-all:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 30px rgba(16, 185, 129, 0.45);
            }

            .btn-save-all:disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

        .save-footer {
            padding: 20px 24px;
            background: rgba(16, 185, 129, 0.05);
            border-top: 2px solid rgba(16, 185, 129, 0.20);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .row-count {
            font-size: 13px;
            color: var(--text-secondary);
            font-weight: 600;
        }

        /* Status Badge */
        .status-badge {
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .status-present {
            background: rgba(16, 185, 129, 0.12);
            color: #10b981;
        }

        .status-absent {
            background: rgba(239, 68, 68, 0.10);
            color: #ef4444;
        }

        .status-leave {
            background: rgba(59, 130, 246, 0.12);
            color: #3b82f6;
        }

        .status-halfday {
            background: rgba(251, 191, 36, 0.15);
            color: #f59e0b;
        }

        .status-holiday {
            background: rgba(139, 92, 246, 0.12);
            color: #8b5cf6;
        }

        .status-weekend {
            background: rgba(107, 114, 128, 0.12);
            color: #6b7280;
        }

        /* TOAST */
        #toastContainer {
            position: fixed;
            top: 90px;
            right: 20px;
            z-index: 999999;
            display: flex;
            flex-direction: column;
            gap: 10px;
            pointer-events: none;
        }

        .toast {
            padding: 14px 20px;
            border-radius: 10px;
            background: #ffffff;
            color: #333;
            font-size: 14px;
            font-weight: 600;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.20);
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 260px;
            max-width: 400px;
            animation: toastIn 0.3s ease;
            pointer-events: auto;
        }

        [data-theme="dark"] .toast {
            background: #1a1a2e;
            color: #fff;
        }

        .toast-success {
            border-left: 4px solid #10b981;
        }

            .toast-success i {
                color: #10b981;
            }

        .toast-error {
            border-left: 4px solid #ef4444;
        }

            .toast-error i {
                color: #ef4444;
            }

        .toast-info {
            border-left: 4px solid #8b5cf6;
        }

            .toast-info i {
                color: #8b5cf6;
            }

        .toast-hide {
            animation: toastOut 0.3s ease forwards;
        }

        @@keyframes toastIn {
            from {
                opacity: 0;
                transform: translateX(40px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@keyframes toastOut {
            from {
                opacity: 1;
                transform: translateX(0);
            }

            to {
                opacity: 0;
                transform: translateX(40px);
            }
        }

        @@media (max-width: 900px) {
            .filter-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- TOAST CONTAINER -->
<div id="toastContainer"></div>

<!-- PAGE HEADER -->
<div class="page-header-bulk">
    <a href="@Url.Action("Index", "Attendance")" class="page-back-btn" title="Back to Attendance">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div class="header-icon">
        <i class="fas fa-users"></i>
    </div>
    <div>
        <h1>Bulk Attendance Entry</h1>
        <p>Mark attendance for all employees at once</p>
    </div>
</div>
<!-- FILTERS -->
<div class="filter-card">
    <form method="get" action="@Url.Action("BulkEntry", "Attendance")">
        <div class="filter-row">
            <div class="filter-group">
                <label><i class="fas fa-calendar"></i> Date</label>
                <input type="date" name="date" value="@attendanceDate.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="filter-group">
                <label><i class="fas fa-building"></i> Branch</label>
                <select name="branchId">
                    @if (branches != null && branches.Count > 1)
                    {
                        <option value="">-- All Branches --</option>
                    }
                    @if (branches != null)
                    {
                        foreach (var b in branches)
                        {
                            <option value="@b.BranchId" @(selectedBranchId == b.BranchId ? "selected" : "")>@b.BranchName</option>
                        }
                    }
                </select>
            </div>

            <div class="filter-group">
                <label><i class="fas fa-clock"></i> Shift</label>
                <select name="shiftId">
                    <option value="">-- All Shifts --</option>
                    @if (shifts != null)
                    {
                        foreach (var s in shifts)
                        {
                            <option value="@s.ShiftId" @(selectedShiftId == s.ShiftId ? "selected" : "")>@s.ShiftName</option>
                        }
                    }
                </select>
            </div>

            <div class="filter-actions">
                <a href="@Url.Action("BulkEntry", "Attendance")" class="btn-filter-reset">
                    <i class="fas fa-redo"></i> Reset
                </a>
                <button type="submit" class="btn-filter-primary">
                    <i class="fas fa-search"></i> Load
                </button>
            </div>
        </div>
    </form>
</div>

<!-- SHIFT INFO BANNER -->
@if (selectedShiftId.HasValue && shifts != null)
{
    var sh = shifts.FirstOrDefault(s => s.ShiftId == selectedShiftId.Value);
    if (sh != null)
    {
        <div class="shift-info">
            <div class="info-text">
                <i class="fas fa-clock"></i>
                <span>Shift Time: @sh.StartTime.ToString(@"hh\:mm") to @sh.EndTime.ToString(@"hh\:mm")</span>
            </div>
            <div class="info-text">
                <i class="fas fa-info-circle"></i>
                <span>Date: @attendanceDate.ToString("dd MMM yyyy")</span>
            </div>
        </div>
    }
}

<!-- ATTENDANCE TABLE -->
<form id="bulkAttendanceForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="attendanceDate" value="@attendanceDate.ToString("yyyy-MM-dd")" />

    <div class="attendance-table-card">
        @if (Model != null && Model.Any())
        {
            <table class="att-table" id="attendanceTable">
                <thead>
                    <tr>
                        <th style="width:40px;">#</th>
                        <th>Name</th>
                        <th>Code</th>
                        <th>Shift</th>
                        <th>IN</th>
                        <th>OUT</th>
                        <th>Break</th>
                        <th>Status</th>
                        <th>Total Work</th>
                        <th>Less</th>
                        <th>Overtime</th>
                        <th>Late</th>
                        <th>Sign</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNo = 1; }
                    @foreach (var row in Model)
                    {
                        <tr data-employee-id="@row.EmployeeId"
                            data-shift-start="@row.ShiftStartTime.ToString(@"hh\:mm")"
                            data-shift-end="@row.ShiftEndTime.ToString(@"hh\:mm")"
                            data-break="@row.BreakDuration">
                            <td>@rowNo</td>
                            <td class="emp-name-cell">@row.EmployeeName</td>
                            <td class="emp-code-cell">@row.EmployeeCode</td>
                            <td>
                                <span style="font-size:11px;">@row.ShiftName</span>
                            </td>
                            <td>
                                <input type="time" class="att-input check-in" name="CheckIn_@row.EmployeeId"
                                       value="@(row.CheckIn.HasValue ? row.CheckIn.Value.ToString(@"hh\:mm") : "")" />
                            </td>
                            <td>
                                <input type="time" class="att-input check-out" name="CheckOut_@row.EmployeeId"
                                       value="@(row.CheckOut.HasValue ? row.CheckOut.Value.ToString(@"hh\:mm") : "")" />
                            </td>
                            <td class="calc-cell">@row.BreakDuration min</td>
                            <td>
                                <select class="att-select status-select" name="Status_@row.EmployeeId">
                                    <option value="1" @(row.Status == AttendanceStatus.Present ? "selected" : "")>Present</option>
                                    <option value="2" @(row.Status == AttendanceStatus.Absent ? "selected" : "")>Absent</option>
                                    <option value="3" @(row.Status == AttendanceStatus.Leave ? "selected" : "")>Leave</option>
                                    <option value="4" @(row.Status == AttendanceStatus.HalfDay ? "selected" : "")>Half Day</option>
                                    <option value="5" @(row.Status == AttendanceStatus.Holiday ? "selected" : "")>Holiday</option>
                                    <option value="6" @(row.Status == AttendanceStatus.Weekend ? "selected" : "")>Weekend</option>
                                </select>
                            </td>
                            <td class="calc-cell worked-hours">@row.WorkedHours.ToString("0.00")</td>
                            <td class="calc-cell calc-less less-time">@row.LessTimeHours.ToString("0.00")</td>
                            <td class="calc-cell calc-ot ot-time">@row.OvertimeHours.ToString("0.00")</td>
                            <td class="calc-cell late-min">@row.LateMinutes</td>
                            <td style="text-align:center;">
                                <input type="checkbox" class="sign-check is-verified" name="IsVerified_@row.EmployeeId"
                                       @(row.IsVerified ? "checked" : "") />
                            </td>
                        </tr>
                        rowNo++;
                    }
                </tbody>
            </table>

            if (canModify)
            {
                <div class="save-footer">
                    <div style="display:flex; gap:8px; flex-wrap:wrap;">
                        <button type="button" class="btn-bulk-action btn-present-all" id="bulkPresentBtn" style="padding:8px 14px; border-radius:8px; background:rgba(16,185,129,0.12); color:#10b981; border:1.5px solid #10b981; font-weight:600; font-size:12px; cursor:pointer; font-family:'Inter',sans-serif;">
                            <i class="fas fa-check"></i> Mark All Present
                        </button>
                        <button type="button" class="btn-bulk-action btn-absent-all" id="bulkAbsentBtn" style="padding:8px 14px; border-radius:8px; background:rgba(239,68,68,0.10); color:#ef4444; border:1.5px solid #ef4444; font-weight:600; font-size:12px; cursor:pointer; font-family:'Inter',sans-serif;">
                            <i class="fas fa-times"></i> Mark All Absent
                        </button>
                        <button type="button" class="btn-bulk-action btn-clear-all" id="bulkClearBtn" style="padding:8px 14px; border-radius:8px; background:rgba(107,114,128,0.10); color:#6b7280; border:1.5px solid #6b7280; font-weight:600; font-size:12px; cursor:pointer; font-family:'Inter',sans-serif;">
                            <i class="fas fa-eraser"></i> Clear All
                        </button>
                    </div>
                    <div style="display:flex; gap:12px; align-items:center;">
                        <div class="row-count">
                            <i class="fas fa-users"></i> Total: <strong>@Model.Count</strong>
                        </div>
                        <button type="submit" class="btn-save-all" id="saveAllBtn">
                            <i class="fas fa-save"></i> Save All Attendance
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div style="text-align:center; padding:60px 20px; color:var(--text-muted);">
                <i class="fas fa-users" style="font-size:48px; opacity:0.5; display:block; margin-bottom:16px;"></i>
                <h3>No Employees Found</h3>
                <p>Please select a branch and click "Load" to view employees.</p>
            </div>
        }
    </div>
</form>

@section scripts {
    <script src="~/Scripts/attendance.js"></script>
}