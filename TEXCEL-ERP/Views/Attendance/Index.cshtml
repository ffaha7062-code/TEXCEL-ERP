@{
    ViewBag.Title = "Attendance";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var todayPresent = ViewBag.TodayPresent != null ? (int)ViewBag.TodayPresent : 0;
    var todayAbsent = ViewBag.TodayAbsent != null ? (int)ViewBag.TodayAbsent : 0;
    var todayLeave = ViewBag.TodayLeave != null ? (int)ViewBag.TodayLeave : 0;
    var upcomingHolidays = ViewBag.UpcomingHolidays != null ? (int)ViewBag.UpcomingHolidays : 0;
}

@section styles {
    <style>
        .page-header {
            margin-bottom: 28px;
        }

            .page-header h1 {
                font-size: 32px;
                font-weight: 800;
                font-family: 'Space Grotesk', sans-serif;
                margin: 0;
                color: var(--text-primary);
            }

                .page-header h1 i {
                    color: var(--gold);
                    margin-right: 12px;
                }

        /* STATS ROW */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 32px;
        }

        .stat-mini {
            background: var(--bg-card);
            border-radius: 14px;
            padding: 16px 20px;
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 14px;
            transition: all 0.3s;
        }

            .stat-mini:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(108, 60, 176, 0.10);
            }

            .stat-mini .stat-icon {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                flex-shrink: 0;
            }

            .stat-mini.present .stat-icon {
                background: rgba(16, 185, 129, 0.12);
                color: #10b981;
            }

            .stat-mini.absent .stat-icon {
                background: rgba(239, 68, 68, 0.10);
                color: #ef4444;
            }

            .stat-mini.leave .stat-icon {
                background: rgba(59, 130, 246, 0.12);
                color: #3b82f6;
            }

            .stat-mini.holiday .stat-icon {
                background: rgba(139, 92, 246, 0.12);
                color: #8b5cf6;
            }

            .stat-mini .stat-num {
                font-size: 22px;
                font-weight: 800;
                font-family: 'Space Grotesk', sans-serif;
                color: var(--text-primary);
                line-height: 1;
            }

            .stat-mini .stat-lbl {
                font-size: 10px;
                font-weight: 700;
                color: var(--text-secondary);
                text-transform: uppercase;
                letter-spacing: 0.5px;
                margin-top: 4px;
            }

        /* NAV CARDS GRID — 6 columns */
        .nav-cards-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 18px;
        }

        .nav-card {
            background: var(--bg-card);
            border-radius: 18px;
            padding: 28px 16px;
            border: 1px solid var(--border-color);
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 16px;
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 20px rgba(108, 60, 176, 0.05);
            position: relative;
            overflow: hidden;
            min-height: 180px;
        }

            .nav-card::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: 3px;
                transform: scaleX(0);
                transition: transform 0.35s;
            }

            .nav-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 20px 50px rgba(108, 60, 176, 0.18);
                border-color: transparent;
            }

                .nav-card:hover::after {
                    transform: scaleX(1);
                }

            .nav-card .card-icon {
                width: 68px;
                height: 68px;
                border-radius: 18px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 28px;
                color: white;
                transition: transform 0.35s;
            }

            .nav-card:hover .card-icon {
                transform: scale(1.10) rotate(-4deg);
            }

            .nav-card .card-title {
                font-size: 13px;
                font-weight: 700;
                font-family: 'Space Grotesk', sans-serif;
                color: var(--text-primary);
                text-align: center;
                letter-spacing: 0.3px;
                transition: color 0.3s;
                line-height: 1.3;
            }

            /* Card colors */
            .nav-card.bulk .card-icon {
                background: linear-gradient(135deg, #6c3cb0, #8b5cf6);
                box-shadow: 0 10px 30px rgba(108, 60, 176, 0.35);
            }

            .nav-card.bulk::after {
                background: linear-gradient(135deg, #6c3cb0, #8b5cf6);
            }

            .nav-card.bulk:hover .card-title {
                color: #8b5cf6;
            }

            .nav-card.single .card-icon {
                background: linear-gradient(135deg, #3b82f6, #14b8a6);
                box-shadow: 0 10px 30px rgba(59, 130, 246, 0.35);
            }

            .nav-card.single::after {
                background: linear-gradient(135deg, #3b82f6, #14b8a6);
            }

            .nav-card.single:hover .card-title {
                color: #3b82f6;
            }

            .nav-card.grid .card-icon {
                background: linear-gradient(135deg, #fbbf24, #f59e0b);
                box-shadow: 0 10px 30px rgba(251, 191, 36, 0.35);
            }

            .nav-card.grid::after {
                background: linear-gradient(135deg, #fbbf24, #f59e0b);
            }

            .nav-card.grid:hover .card-title {
                color: #f59e0b;
            }

            .nav-card.holiday .card-icon {
                background: linear-gradient(135deg, #8b5cf6, #ec4899);
                box-shadow: 0 10px 30px rgba(139, 92, 246, 0.35);
            }

            .nav-card.holiday::after {
                background: linear-gradient(135deg, #8b5cf6, #ec4899);
            }

            .nav-card.holiday:hover .card-title {
                color: #ec4899;
            }

            .nav-card.myattendance .card-icon {
                background: linear-gradient(135deg, #14b8a6, #06b6d4);
                box-shadow: 0 10px 30px rgba(20, 184, 166, 0.35);
            }

            .nav-card.myattendance::after {
                background: linear-gradient(135deg, #14b8a6, #06b6d4);
            }

            .nav-card.myattendance:hover .card-title {
                color: #06b6d4;
            }

            /* Reports card — different look */
            .nav-card.reports .card-icon {
                background: linear-gradient(135deg, #6366f1, #8b5cf6);
                box-shadow: 0 10px 30px rgba(99, 102, 241, 0.35);
            }

            .nav-card.reports::after {
                background: linear-gradient(135deg, #6366f1, #8b5cf6);
            }

            .nav-card.reports:hover .card-title {
                color: #6366f1;
            }

            .nav-card.reports {
                border-top: 3px solid #6366f1;
            }

        /* Responsive */
        @@media (max-width: 1300px) {
            .nav-cards-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (max-width: 900px) {
            .stats-row {
                grid-template-columns: repeat(2, 1fr);
            }

            .nav-cards-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 550px) {

            .stats-row,
            .nav-cards-grid {
                grid-template-columns: 1fr;
            }

            .nav-card {
                padding: 24px;
                min-height: 150px;
            }

                .nav-card .card-icon {
                    width: 60px;
                    height: 60px;
                    font-size: 24px;
                }
        }
    </style>
}

<!-- PAGE HEADER -->
<div class="page-header">
    <h1><i class="fas fa-calendar-check"></i> Attendance Management</h1>
</div>

<!-- STATS ROW -->
<div class="stats-row">
    <div class="stat-mini present">
        <div class="stat-icon"><i class="fas fa-user-check"></i></div>
        <div>
            <div class="stat-num">@todayPresent</div>
            <div class="stat-lbl">Present Today</div>
        </div>
    </div>

    <div class="stat-mini absent">
        <div class="stat-icon"><i class="fas fa-user-times"></i></div>
        <div>
            <div class="stat-num">@todayAbsent</div>
            <div class="stat-lbl">Absent Today</div>
        </div>
    </div>

    <div class="stat-mini leave">
        <div class="stat-icon"><i class="fas fa-plane-departure"></i></div>
        <div>
            <div class="stat-num">@todayLeave</div>
            <div class="stat-lbl">On Leave</div>
        </div>
    </div>

    <div class="stat-mini holiday">
        <div class="stat-icon"><i class="fas fa-calendar-alt"></i></div>
        <div>
            <div class="stat-num">@upcomingHolidays</div>
            <div class="stat-lbl">Upcoming Holidays</div>
        </div>
    </div>
</div>

<!-- 6 NAV CARDS -->
<div class="nav-cards-grid">

    <a href="@Url.Action("BulkEntry", "Attendance")" class="nav-card bulk">
        <div class="card-icon"><i class="fas fa-users"></i></div>
        <div class="card-title">Bulk Attendance</div>
    </a>

    <a href="@Url.Action("SingleEntry", "Attendance")" class="nav-card single">
        <div class="card-icon"><i class="fas fa-user-check"></i></div>
        <div class="card-title">Single Attendance</div>
    </a>

    <a href="@Url.Action("MonthlyGrid", "Attendance")" class="nav-card grid">
        <div class="card-icon"><i class="fas fa-th"></i></div>
        <div class="card-title">Monthly Grid</div>
    </a>

    <a href="@Url.Action("Index", "Holiday")" class="nav-card holiday">
        <div class="card-icon"><i class="fas fa-calendar-alt"></i></div>
        <div class="card-title">Holidays</div>
    </a>

    <a href="@Url.Action("MyAttendance", "Attendance")" class="nav-card myattendance">
        <div class="card-icon"><i class="fas fa-user-clock"></i></div>
        <div class="card-title">My Attendance</div>
    </a>

    <a href="@Url.Action("Index", "AttendanceReport")" class="nav-card reports">
        <div class="card-icon"><i class="fas fa-chart-bar"></i></div>
        <div class="card-title">Reports</div>
    </a>

</div>